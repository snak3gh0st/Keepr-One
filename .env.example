# Postgres (host btdb, via pgbouncer, rede privada Coolify)
DATABASE_URL="postgresql://lifeos_app:CHANGE_ME@10.0.0.2:6432/lifeos"

# Better Auth
BETTER_AUTH_SECRET="CHANGE_ME"
BETTER_AUTH_URL="http://localhost:3000"

# National Life browser integration (lib/national-life/env.ts)
# Optional in all environments: the /agent/integrations/national-life page and its
# server actions stay disabled (isNationalLifeConfigured() === false) until every
# variable below is set and valid.
STEEL_BASE_URL="https://CHANGE_ME"
STEEL_API_KEY="CHANGE_ME"
# Comma-separated list of HTTPS origins the browser worker is allowed to visit.
NATIONAL_LIFE_PORTAL_ORIGINS="https://agent.nationallife.example"
# Must be one of the origins listed above.
NATIONAL_LIFE_PORTAL_LOGIN_URL="https://agent.nationallife.example/login"
NATIONAL_LIFE_CREDENTIAL_SCOPE_ID="CHANGE_ME"
NATIONAL_LIFE_CREDENTIAL_KEY_VERSION="v1"
# JSON map of key version -> base64-encoded 32-byte AES-256-GCM key, e.g. {"v1":"<base64>"}
NATIONAL_LIFE_CREDENTIAL_KEYS="CHANGE_ME"
