# Postgres (host btdb, via pgbouncer, rede privada Coolify)
DATABASE_URL="postgresql://lifeos_app:CHANGE_ME@10.0.0.2:6432/lifeos"

# Better Auth
BETTER_AUTH_SECRET="CHANGE_ME"
BETTER_AUTH_URL="https://app.keepr.one"

# KeeproneConnect — National Life local connector (independent from Steel below)
# Default-off. Enabling requires a stable Chrome extension ID (from the manifest key).
# Omit STORE_URL for pilot/unpacked installs. Set STORE_URL only when the official
# Chrome Web Store listing is live and matches the extension ID.
# NATIONAL_LIFE_LOCAL_CONNECTOR_ENABLED="false"
# NATIONAL_LIFE_LOCAL_CONNECTOR_EXTENSION_ID="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
# NATIONAL_LIFE_LOCAL_CONNECTOR_STORE_URL="https://chromewebstore.google.com/detail/keeproneconnect/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

# Varredura das tabelas que o conector local faz crescer para sempre — replay de
# assinatura, pairings vencidos, recibos de estágio de runs terminais antigos.
# Liga sozinha no boot do servidor (instrumentation.ts); nada a configurar para
# funcionar. O intervalo padrão é 900s (mínimo 60, máximo 86400).
# NATIONAL_LIFE_JANITOR_DISABLED="false"
# NATIONAL_LIFE_JANITOR_INTERVAL_SECONDS="900"
# Segredo do disparo manual em POST /api/internal/national-life/connector-janitor
# (header `Authorization: Bearer ...`). Mínimo de 32 caracteres. Sem ele a rota
# responde 404 e só o intervalo automático varre.
# NATIONAL_LIFE_JANITOR_SECRET="CHANGE_ME"

# National Life browser integration (lib/national-life/env.ts)
# Optional in all environments: the /agent/integrations/national-life page and its
# server actions stay disabled (isNationalLifeConfigured() === false) until every
# variable below is set and valid.
# HTTPS remains required for an external Steel endpoint. The approved private
# Coolify deployment uses exactly http://national-life-steel:3000 (Docker-only).
STEEL_BASE_URL="http://national-life-steel:3000"
STEEL_API_KEY="CHANGE_ME"
# Comma-separated list of HTTPS origins the browser worker is allowed to visit.
NATIONAL_LIFE_PORTAL_ORIGINS="https://www.nationallife.com,https://nlg-prod.auth0.com,https://nlg-prod.us.auth0.com,https://mfa.nationallife.com"
# Must be one of the origins listed above.
NATIONAL_LIFE_PORTAL_LOGIN_URL="https://www.nationallife.com/agent/auth/login?returnUrl=%2Fagent%2F"
NATIONAL_LIFE_SESSION_SCOPE_ID="CHANGE_ME_UNIQUE_DEPLOYMENT_SCOPE"
NATIONAL_LIFE_SESSION_KEY_VERSION="v1"
# JSON map of key version -> base64-encoded 32-byte AES-256-GCM key, e.g. {"v1":"<base64>"}
NATIONAL_LIFE_SESSION_KEYS="CHANGE_ME"
# Independent base64-encoded 32-byte signing key for one-time viewer tickets.
NATIONAL_LIFE_VIEWER_SIGNING_KEY="CHANGE_ME"
NATIONAL_LIFE_VIEWER_PUBLIC_ORIGIN="https://national-life-viewer.keepr.one"
NATIONAL_LIFE_VIEWER_BIND_HOST="0.0.0.0"
NATIONAL_LIFE_VIEWER_PORT="3010"
# Must be unique for each concurrently running runtime container.
NATIONAL_LIFE_RUNTIME_WORKER_ID="national-life-runtime-1"
# Access remains restricted to this exact comma-separated agent allowlist.
NATIONAL_LIFE_INTERACTIVE_LOGIN_ENABLED="false"
NATIONAL_LIFE_INTERACTIVE_LOGIN_AGENT_IDS="agent-id-1"
# Enables every authenticated agent account. Leave the named allowlist empty when true.
NATIONAL_LIFE_INTERACTIVE_LOGIN_ALL_AGENTS="false"
# Makes each keep-alive tick also traverse /agent/sso/foresight, so the carrier's
# Auth0 session is renewed alongside the portal one. Only worth turning on if
# scripts/national-life-probe-foresight-session.ts shows an Auth0 cookie deadline
# moving forward after the jump; otherwise the lifetime is absolute.
NATIONAL_LIFE_KEEP_ALIVE_SSO_JUMP="false"
# Browser fleet configuration. Provider/shard/retry values are local-safe
# defaults; production capacities must be explicitly configured in Coolify.
NATIONAL_LIFE_BROWSER_PROVIDER="steel"
NATIONAL_LIFE_BROWSER_SHARD_ID="national-life-shard-1"
NATIONAL_LIFE_MAX_INTERACTIVE_SESSIONS="10"
NATIONAL_LIFE_MAX_SESSIONS_PER_SHARD="2"
NATIONAL_LIFE_INTERACTIVE_RECONNECT_BASE_DELAY_MS="1000"
NATIONAL_LIFE_INTERACTIVE_RECONNECT_MAX_DELAY_MS="30000"
