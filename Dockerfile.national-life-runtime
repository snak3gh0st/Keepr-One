FROM node:22-alpine

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN corepack enable && corepack prepare pnpm@11.15.1 --activate
RUN pnpm install --frozen-lockfile

COPY prisma/schema.prisma ./prisma/schema.prisma
RUN pnpm exec prisma generate

COPY tsconfig.json ./
COPY lib/prisma.ts ./lib/prisma.ts
COPY lib/integrations/idempotency.ts ./lib/integrations/idempotency.ts
COPY lib/national-life/browser-context-crypto.ts ./lib/national-life/browser-context-crypto.ts
COPY lib/national-life/connection-attempt-state.ts ./lib/national-life/connection-attempt-state.ts
COPY lib/national-life/constants.ts ./lib/national-life/constants.ts
COPY lib/national-life/env.ts ./lib/national-life/env.ts
COPY lib/national-life/job-service.ts ./lib/national-life/job-service.ts
COPY lib/national-life/job-state.ts ./lib/national-life/job-state.ts
COPY lib/national-life/redaction.ts ./lib/national-life/redaction.ts
COPY lib/national-life/status-map.ts ./lib/national-life/status-map.ts
COPY lib/national-life/sync-service.ts ./lib/national-life/sync-service.ts
COPY lib/national-life/viewer-token.ts ./lib/national-life/viewer-token.ts
COPY workers/national-life/adapter.ts ./workers/national-life/adapter.ts
COPY workers/national-life/run-connection-attempt.ts ./workers/national-life/run-connection-attempt.ts
COPY workers/national-life/run-job.ts ./workers/national-life/run-job.ts
COPY workers/national-life/runtime.ts ./workers/national-life/runtime.ts
COPY workers/national-life/steel-session.ts ./workers/national-life/steel-session.ts
COPY workers/national-life/types.ts ./workers/national-life/types.ts
COPY workers/national-life/viewer-broker.ts ./workers/national-life/viewer-broker.ts
COPY scripts/national-life-runtime.ts ./scripts/national-life-runtime.ts

ENV NODE_ENV=production
EXPOSE 3010
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3010/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["pnpm", "worker:national-life"]
