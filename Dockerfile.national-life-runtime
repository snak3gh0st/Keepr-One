FROM node:22-alpine

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN corepack enable && corepack prepare pnpm@11.15.1 --activate
RUN pnpm install --frozen-lockfile

COPY prisma/schema.prisma ./prisma/schema.prisma
RUN pnpm exec prisma generate

COPY tsconfig.json ./
COPY lib/prisma.ts ./lib/prisma.ts
COPY lib/integrations/idempotency.ts ./lib/integrations/idempotency.ts

# Whole directories rather than file by file. Listing each module meant every new
# one was missing from the image and only failed at runtime with
# MODULE_NOT_FOUND — that happened three times. The surface stays limited to the
# National Life code; test files are excluded by .dockerignore.
COPY lib/national-life/ ./lib/national-life/
COPY workers/national-life/ ./workers/national-life/
COPY scripts/national-life-runtime.ts ./scripts/national-life-runtime.ts
COPY scripts/national-life-sync-snapshots.ts ./scripts/national-life-sync-snapshots.ts
COPY scripts/national-life-sync-commission-detail.ts ./scripts/national-life-sync-commission-detail.ts
COPY scripts/national-life-describe-grids.ts ./scripts/national-life-describe-grids.ts
COPY scripts/national-life-describe-page.ts ./scripts/national-life-describe-page.ts
COPY scripts/national-life-find-handler.ts ./scripts/national-life-find-handler.ts

ENV NODE_ENV=production
EXPOSE 3010
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3010/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["pnpm", "worker:national-life"]
