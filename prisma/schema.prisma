// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENT
  CLIENT
}

enum AgentStatus {
  ACTIVE
  INACTIVE
}

enum PolicyStatus {
  PENDING
  APPROVED
  INFORCE
  LAPSED
  CANCELLED
}

enum CommissionType {
  DIRECT
  OVERRIDE
}

enum ImportType {
  POLICIES
  COMMISSIONS
}

enum ImportStatus {
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum CaseStage {
  LEAD
  DISCOVERY
  DESIGN
  ILLUSTRATION_READY
  APPLICATION_STARTED
  SUBMITTED
  UNDERWRITING
  APPROVED
  ISSUED
  PLACED
  DECLINED
  WITHDRAWN
}

enum CaseStatus {
  OPEN
  CLOSED
}

enum IllustrationKind {
  PRELIMINARY
  OFFICIAL
}

enum ApplicationStatus {
  DRAFT
  STARTED
  SUBMITTED
  UNDERWRITING
  APPROVED
  ISSUED
  DECLINED
  WITHDRAWN
}

enum NationalLifeConnectorCommandState {
  QUEUED
  RUNNING
  AUTH_REQUIRED
  WAITING_FOR_CONFIRMATION
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum NationalLifeConnectorConfirmationState {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum RequirementStatus {
  OPEN
  RECEIVED
  WAIVED
}

enum PolicyTransactionType {
  PREMIUM
  CHARGE
  LOAN
  WITHDRAWAL
  ADJUSTMENT
}

enum CommissionTransactionType {
  EXPECTED
  PAID
  CHARGEBACK
  ADJUSTMENT
}

enum SyncStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  NEEDS_REVIEW
}

enum BrowserJobState {
  QUEUED
  RUNNING
  ACTION_REQUIRED
  WAITING_FOR_MFA
  WAITING_FOR_REVIEW
  RETRYABLE
  CREDENTIALS_EXPIRED
  MANUAL_REVIEW
  SUCCEEDED
  FAILED
  CANCELLED
}

enum BrowserJobOperation {
  TEST_CONNECTION
  SYNC_CASE_READ
  GET_RAPID_SOLVE_QUOTE
  GENERATE_ILLUSTRATION_PDF
  SYNC_NATIONAL_LIFE_GRID
  SYNC_FORESIGHT_READ
  GENERATE_FORESIGHT_PDF
}

enum NationalLifeSyncRunState {
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  PARTIAL
  FAILED
}

enum NationalLifeForesightReadRunState {
  QUEUED
  RUNNING
  PAUSED
  PARTIAL
  COMPLETED
  FAILED
}

enum NationalLifeForesightReadMode {
  INVENTORY
  DETAIL
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role
  createdAt DateTime @default(now())

  agent             Agent?
  client            Client?
  imports           ImportBatch[]
  auditLogs         AuditLog[]
  emailVerified     Boolean          @default(false)
  image             String?
  updatedAt         DateTime         @updatedAt
  sessions          Session[]
  accounts          Account[]
  uploadedDocuments PolicyDocument[]

  @@map("user")
}

model Agent {
  id            String      @id @default(cuid())
  userId        String      @unique
  user          User        @relation(fields: [userId], references: [id])
  parentAgentId String?
  parentAgent   Agent?      @relation("AgentHierarchy", fields: [parentAgentId], references: [id])
  subAgents     Agent[]     @relation("AgentHierarchy")
  rank          String
  npn           String?     @unique
  status        AgentStatus @default(ACTIVE)
  createdAt     DateTime    @default(now())

  clients                               Client[]
  policies                              Policy[]
  commissionRecords                     CommissionRecord[]
  prospects                             Prospect[]
  insuranceCases                        InsuranceCase[]
  commissionTransactions                CommissionTransaction[]
  integrationCredentials                AgentIntegrationCredential[]
  integrationSessions                   AgentIntegrationSession[]
  nationalLifeConnectionAttempts        NationalLifeConnectionAttempt[]
  browserJobs                           BrowserAutomationJob[]
  nationalLifeSyncRuns                  NationalLifeSyncRun[]
  nationalLifeCaseSnapshots             NationalLifeCaseSnapshot[]
  nationalLifeForesightReadRuns         NationalLifeForesightReadRun[]
  nationalLifeForesightCaseSnapshots    NationalLifeForesightCaseSnapshot[]
  nationalLifeForesightServiceSnapshots NationalLifeForesightServiceSnapshot[]
  nationalLifeForesightDocuments        NationalLifeForesightDocument[]
  illustrations                         Illustration[]
  nationalLifeInforcePolicies           NationalLifeInforcePolicy[]
  nationalLifeReportRows                NationalLifeReportRow[]
  nationalLifeRawGridPages              NationalLifeRawGridPage[]
  nationalLifeConnectorPairings         NationalLifeConnectorPairing[]
  nationalLifeConnectorDevices          NationalLifeConnectorDevice[]
  nationalLifeConnectorCommands         NationalLifeConnectorCommand[]
  nationalLifeExportUploads             NationalLifeExportUpload[]
  messagingAccount                      AgentMessagingAccount?

  @@index([parentAgentId])
}

/// Raw landing zone for rows read from the National Life agent portal grids.
/// Deliberately not mapped into Prospect/InsuranceCase/Application yet: that
/// mapping is a separate decision, and Policy still holds synthetic seed rows.
/// `raw` keeps the untouched carrier payload so no field is lost to normalisation.
model NationalLifeCaseSnapshot {
  id                       String   @id @default(cuid())
  agentId                  String
  agent                    Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deploymentScope          String
  gridKey                  String
  policyNo                 String
  insuredName              String?
  ownerName                String?
  product                  String?
  carrierStatus            String?
  deliveryStatus           String?
  actionRequired           String?
  requirements             String?
  submitDate               String?
  sentDate                 String?
  modalPremium             String?
  anticipatedAnnualPremium String?
  submitMethod             String?
  caseManager              String?
  agency                   String?
  writingAgentName         String?
  writingAgentNumber       String?
  companyCode              String?
  raw                      Json
  fetchedAt                DateTime
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([agentId, deploymentScope, gridKey, policyNo])
  @@index([agentId, gridKey])
  @@index([fetchedAt])
}

/// Raw landing zone for the inforce book grid. Distinct from
/// NationalLifeCaseSnapshot: this is policy/client demographic data (owner and
/// insured name, DOB, address, contact, cash value), not a submission-pipeline
/// case, and the carrier's own field names differ (PolicyNumber, not PolicyNo).
/// Contains real client PII, stored in plaintext to match how Client already
/// stores name/email/phone in this schema — same trust boundary, no new gap.
model NationalLifeInforcePolicy {
  id                       String   @id @default(cuid())
  agentId                  String
  agent                    Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deploymentScope          String
  policyNumber             String
  nbPolicyNumber           String?
  policyStatus             String?
  policyIssueDate          String?
  lastStatusChangeDate     String?
  productClass             String?
  productName              String?
  productCode              String?
  companyCode              String?
  systemCode               String?
  planCode                 String?
  agentNumber              String?
  agentName                String?
  servicingAgentName       String?
  servicingAgencyName      String?
  insuredClientName        String?
  insuredDob               String?
  insuredEmail             String?
  insuredPhoneNumber       String?
  ownerClientName          String?
  ownerDob                 String?
  ownerEmail               String?
  ownerPhoneNumber         String?
  insuredAddress           String?
  insuredAddressLine1      String?
  insuredAddressLine2      String?
  insuredCity              String?
  insuredState             String?
  insuredZipcode           String?
  ownerAddress             String?
  ownerAddressLine1        String?
  ownerAddressLine2        String?
  ownerCity                String?
  ownerState               String?
  ownerZipcode             String?
  accumulatedCashValue     String?
  anticipatedAnnualPremium String?
  termConversionDate       String?
  levelPeriodEndDate       String?
  employerName             String?
  raw                      Json
  fetchedAt                DateTime
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([agentId, deploymentScope, policyNumber])
  @@index([agentId])
  @@index([fetchedAt])
}

/// Generic landing zone for the portal's report grids — paid commissions,
/// projected commissions, and whatever else is mapped later.
///
/// One table rather than one per report: these are statement-level summaries (8
/// and 4 rows respectively, not transaction ledgers) whose columns differ
/// completely from each other, so typed columns per report would be mostly nulls.
/// `raw` holds the carrier row verbatim and `amounts` the numeric fields pulled
/// out of it, which is what a front end needs without a migration per report.
model NationalLifeReportRow {
  id              String   @id @default(cuid())
  agentId         String
  agent           Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deploymentScope String
  gridKey         String
  /// Deterministic per-report identity, so a re-sync updates instead of duplicating.
  rowKey          String
  primaryDate     String?
  label           String?
  amounts         Json
  raw             Json
  fetchedAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([agentId, deploymentScope, gridKey, rowKey])
  @@index([agentId, gridKey])
  @@index([fetchedAt])
}

/// Faithful, page-by-page landing zone for the latest verified carrier grid.
///
/// The normalized models above intentionally collapse duplicate policies and
/// reject rows without a usable business key. This model does neither: every
/// record delivered by the National Life grid is retained in its original
/// order and shape. Pages from an older successful snapshot are removed only
/// after the replacement stage has reconciled against `recordsTotal`.
model NationalLifeRawGridPage {
  id              String              @id @default(cuid())
  agentId         String
  agent           Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deploymentScope String
  runId           String
  run             NationalLifeSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  gridKey         String
  sequence        Int
  recordCount     Int
  contentHash     String
  records         Json
  observedAt      DateTime
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([runId, gridKey, sequence])
  @@index([agentId, deploymentScope, gridKey])
  @@index([runId, gridKey])
}

model NationalLifeForesightReadRun {
  id                String                            @id @default(cuid())
  agentId           String
  agent             Agent                             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deploymentScope   String                            @default("SINGLE_DEPLOYMENT")
  provider          String                            @default("NATIONAL_LIFE")
  mode              NationalLifeForesightReadMode
  state             NationalLifeForesightReadRunState @default(QUEUED)
  targetCaseId      String?
  totalCases        Int                               @default(0)
  inventoriedCases  Int                               @default(0)
  totalServices     Int                               @default(0)
  completedServices Int                               @default(0)
  currentCaseName   String?
  currentService    String?
  safeErrorCode     String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime                          @default(now())
  updatedAt         DateTime                          @updatedAt
  jobs              BrowserAutomationJob[]

  @@index([agentId, deploymentScope, state, createdAt])
}

model NationalLifeForesightCaseSnapshot {
  id              String                                 @id @default(cuid())
  agentId         String
  agent           Agent                                  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deploymentScope String
  provider        String                                 @default("NATIONAL_LIFE")
  externalKey     String
  displayName     String
  caseKind        String?
  product         String?
  status          String?
  state           String?
  observedAt      DateTime
  raw             Json
  createdAt       DateTime                               @default(now())
  updatedAt       DateTime                               @updatedAt
  services        NationalLifeForesightServiceSnapshot[]
  documents       NationalLifeForesightDocument[]

  @@unique([agentId, deploymentScope, provider, externalKey])
  @@unique([id, agentId, deploymentScope, provider])
  @@index([agentId, deploymentScope, observedAt])
}

model NationalLifeForesightServiceSnapshot {
  id              String                            @id @default(cuid())
  caseSnapshotId  String
  agentId         String
  agent           Agent                             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deploymentScope String
  provider        String                            @default("NATIONAL_LIFE")
  caseSnapshot    NationalLifeForesightCaseSnapshot @relation(fields: [caseSnapshotId, agentId, deploymentScope, provider], references: [id, agentId, deploymentScope, provider], onDelete: Cascade)
  serviceName     String
  payloadShape    Json
  payload         Json
  validationState String
  observedAt      DateTime
  createdAt       DateTime                          @default(now())
  updatedAt       DateTime                          @updatedAt

  @@unique([caseSnapshotId, serviceName])
  @@index([caseSnapshotId, observedAt])
  @@index([agentId, deploymentScope, provider, observedAt])
}

model NationalLifeForesightDocument {
  id              String                            @id @default(cuid())
  caseSnapshotId  String
  agentId         String
  agent           Agent                             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deploymentScope String
  provider        String                            @default("NATIONAL_LIFE")
  caseSnapshot    NationalLifeForesightCaseSnapshot @relation(fields: [caseSnapshotId, agentId, deploymentScope, provider], references: [id, agentId, deploymentScope, provider], onDelete: Cascade)
  reportKey       String
  filename        String
  mimeType        String
  byteSize        Int
  contentHash     String
  /// Caminho do PDF dentro de `UPLOADS_DIR`. Nulo em linhas escritas antes desta
  /// coluna — o backfill (`scripts/national-life-backfill-foresight-documents.ts`)
  /// é quem as move.
  storageKey      String?
  /// O PDF em si, quando ainda está no banco. Escritas novas nascem com `bytes`
  /// nulo e `storageKey` preenchido; a coluna sobrevive para não perder o que já
  /// foi gravado. Derrubá-la é uma migração separada, depois do backfill
  /// verificado em produção — dropar dado e mudar caminho de escrita no mesmo
  /// deploy não deixa para onde voltar.
  bytes           Bytes?
  renderState     String
  safeErrorCode   String?
  fetchedAt       DateTime?
  createdAt       DateTime                          @default(now())
  updatedAt       DateTime                          @updatedAt

  @@unique([caseSnapshotId, reportKey])
  @@index([caseSnapshotId, createdAt])
  @@index([agentId, deploymentScope, provider, createdAt])
}

model Client {
  id              String    @id @default(cuid())
  userId          String?   @unique
  user            User?     @relation(fields: [userId], references: [id])
  name            String
  email           String?
  phone           String?
  // The carrier reports it on every inforce policy, for 98% of the book. Stored
  // as a date rather than the carrier's MM/DD/YYYY string so age and birthdays
  // are computable instead of needing to be re-parsed at every call site.
  dateOfBirth     DateTime?
  assignedAgentId String
  assignedAgent   Agent     @relation(fields: [assignedAgentId], references: [id])
  createdAt       DateTime  @default(now())

  policies       Policy[]
  insuranceCases InsuranceCase[]
  illustrations  Illustration[]

  @@index([assignedAgentId])
}

model Policy {
  id               String         @id @default(cuid())
  clientId         String
  client           Client         @relation(fields: [clientId], references: [id])
  agentId          String
  agent            Agent          @relation(fields: [agentId], references: [id])
  carrier          String
  product          String
  policyNumber     String         @unique
  // Null means "not known yet", not zero. Face amount is absent from all 33
  // columns of the carrier's official export and exists only on the per-policy
  // detail page, so it arrives by backfill, long after the row itself. The
  // previous required column is why the CSV import wrote 0.00 on all 9,614
  // rows — a wrong number is worse than a missing one.
  faceAmount       Decimal?
  // The carrier's own status string, kept beside the mapped enum. PolicyStatus
  // has no "Pending Lapse", and that is precisely the status worth acting on,
  // so mapping it to INFORCE alone would erase the signal.
  sourceStatus     String?
  // The modal premium — what the client actually pays each time — kept with the
  // mode it is paid in. Annualising on write would destroy the distinction the
  // client chose: $250 monthly and $250 annual are different policies.
  // Null means the carrier has not supplied a premium in a structured source.
  // It must not be rendered or aggregated as zero.
  premium          Decimal?
  premiumMode      String?
  status           PolicyStatus
  effectiveDate    DateTime?
  lastPaymentDate  DateTime?
  statusChangedAt  DateTime?
  importBatchId    String?
  importBatch      ImportBatch?   @relation(fields: [importBatchId], references: [id])
  caseId           String?
  case             InsuranceCase? @relation(fields: [caseId], references: [id])
  sourceProvider   String?
  sourceExternalId String?
  sourceUpdatedAt  DateTime?
  createdAt        DateTime       @default(now())

  commissionRecords      CommissionRecord[]
  documents              PolicyDocument[]
  snapshots              PolicySnapshot[]
  transactions           PolicyTransaction[]
  commissionTransactions CommissionTransaction[]
  reviews                PolicyReview[]

  @@unique([sourceProvider, sourceExternalId])
  @@index([agentId])
  @@index([clientId])
  @@index([caseId])
}

model Prospect {
  id              String          @id @default(cuid())
  firstName       String
  lastName        String
  email           String?
  phone           String?
  dateOfBirth     DateTime?
  state           String?
  tobaccoStatus   String?
  assignedAgentId String
  assignedAgent   Agent           @relation(fields: [assignedAgentId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  cases           InsuranceCase[]

  @@index([assignedAgentId])
}

model InsuranceCase {
  id              String                 @id @default(cuid())
  prospectId      String
  prospect        Prospect               @relation(fields: [prospectId], references: [id])
  assignedAgentId String
  assignedAgent   Agent                  @relation(fields: [assignedAgentId], references: [id])
  clientId        String?
  client          Client?                @relation(fields: [clientId], references: [id])
  stage           CaseStage              @default(LEAD)
  status          CaseStatus             @default(OPEN)
  objective       String?
  targetCoverage  Decimal?
  monthlyBudget   Decimal?
  needsAnalysis   Json?
  carrier         String?
  productType     String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  illustrations   Illustration[]
  applications    Application[]
  timelineEvents  CaseTimelineEvent[]
  policies        Policy[]
  browserJobs     BrowserAutomationJob[]

  @@index([assignedAgentId, stage])
  @@index([prospectId])
  @@index([clientId])
}

/// One Chatwoot account per agent, never a shared account with per-inbox rules:
/// agents are independent and a configuration slip would show one agent's book to
/// a competitor. Isolation is structural here, not procedural.
model AgentMessagingAccount {
  id                String   @id @default(cuid())
  agentId           String   @unique
  agent             Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  provider          String   @default("CHATWOOT")
  externalAccountId String
  externalUserId    String
  externalUserToken String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, externalAccountId])
}

model AgentIntegrationCredential {
  id              String    @id @default(cuid())
  agentId         String
  agent           Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  provider        String
  maskedUsername  String
  keyVersion      String
  algorithm       String
  iv              String
  ciphertext      String
  authTag         String
  status          String    @default("UNTESTED")
  lastTestedAt    DateTime?
  lastSucceededAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([agentId, provider])
  @@index([provider, status])
}

model AgentIntegrationSession {
  id                       String    @id @default(cuid())
  agentId                  String
  agent                    Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deploymentScope          String    @default("SINGLE_DEPLOYMENT")
  provider                 String
  purpose                  String    @default("CARRIER_SESSION")
  status                   String    @default("CONNECTED")
  formatVersion            Int       @default(1)
  keyVersion               String?
  algorithm                String?
  iv                       String?
  ciphertext               String?
  authTag                  String?
  // Derived from the shortest cookie expiry, which measured on 2026-07-31 is
  // Cloudflare's 30-minute bot cookie — the portal answered authenticated three
  // minutes past it. Kept because the probe output references it, but it is not
  // a session deadline and is no longer shown as one.
  carrierExpiresAt         DateTime?
  lastConnectedAt          DateTime
  lastUsedAt               DateTime?
  // The illustration path (Foresight) sits behind the carrier's Auth0 tenant,
  // whose session dies while the portal session lives. Written by the outcome of
  // the two jobs that actually cross the SSO jump (SYNC_FORESIGHT_READ and
  // GENERATE_FORESIGHT_PDF), not by the keep-alive tick — which is off in
  // production, and is why this field used to go stale. The agent learns the PDF
  // is out of reach before clicking towards it. Last crossing only — nothing
  // here predicts the next one.
  illustrationSsoReachable Boolean?
  illustrationSsoCheckedAt DateTime?
  /// The browser the human actually logged in on, kept alive instead of thrown
  /// away.
  ///
  /// The illustration tool's token lives in the page's memory — `auth0-spa-js`
  /// defaults to `cacheLocation: memory`, and the stored context confirms it:
  /// the identity provider's `localStorage` holds only orphaned `/authorize`
  /// transactions, never a cached token. So a browser rebuilt from cookies
  /// wakes up without one and has to cross the identity provider again, which
  /// is what has been burning the session. The browser that logged in is the
  /// one that has the token, so jobs reattach to it.
  ///
  /// Stored in the clear on purpose: Steel has no public route and lives on a
  /// private Docker network, so the handle is useless without access there —
  /// and anyone who has that already has the running browser. Encrypting it
  /// beside a cookie jar that grants the same access would be ceremony.
  ///
  /// Null is the ordinary state, not an error: it means no live browser is
  /// held and every job builds its own from the stored context, exactly as
  /// before this column existed.
  liveSteelSessionId       String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@unique([agentId, deploymentScope, provider, purpose])
  @@index([provider, status])
}

model NationalLifeConnectionAttempt {
  id                     String    @id @default(cuid())
  agentId                String
  agent                  Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deploymentScope        String    @default("SINGLE_DEPLOYMENT")
  provider               String
  purpose                String    @default("INTERACTIVE_CONNECTION_ATTEMPT")
  state                  String
  formatVersion          Int       @default(1)
  runtimeKeyVersion      String?
  runtimeAlgorithm       String?
  runtimeIv              String?
  runtimeCiphertext      String?
  runtimeAuthTag         String?
  viewerNonceHash        String?
  currentOrigin          String?
  safeErrorCode          String?
  nextPollAt             DateTime?
  reconnectAttemptCount  Int       @default(0)
  browserProvider        String?
  browserShardId         String?
  lastTransportFailureAt DateTime?
  leaseOwner             String?
  leaseExpiresAt         DateTime?
  expiresAt              DateTime
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([agentId, deploymentScope, provider, purpose])
  @@index([state, expiresAt])
  @@index([leaseExpiresAt])
  @@index([state, nextPollAt])
}

model BrowserAutomationJob {
  id                     String                        @id @default(cuid())
  agentId                String
  agent                  Agent                         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deploymentScope        String?
  caseId                 String?
  insuranceCase          InsuranceCase?                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  provider               String
  operation              BrowserJobOperation
  syncRunId              String?
  syncRun                NationalLifeSyncRun?          @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  foresightRunId         String?
  foresightRun           NationalLifeForesightReadRun? @relation(fields: [foresightRunId], references: [id], onDelete: Cascade)
  syncStageIndex         Int?
  syncGridKey            String?
  state                  BrowserJobState               @default(QUEUED)
  idempotencyKey         String                        @unique
  input                  Json
  result                 Json?
  safeErrorCode          String?
  safeErrorDetail        Json?
  attemptCount           Int                           @default(0)
  availableAt            DateTime                      @default(now())
  leaseOwner             String?
  leaseExpiresAt         DateTime?
  continuationKeyVersion String?
  continuationIv         String?
  continuationCiphertext String?
  continuationAuthTag    String?
  continuationExpiresAt  DateTime?
  startedAt              DateTime?
  finishedAt             DateTime?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt

  @@index([state, availableAt])
  @@index([agentId, createdAt])
  @@index([agentId, deploymentScope, provider])
  @@index([caseId, createdAt])
  @@index([syncRunId, syncStageIndex, state])
}

model NationalLifeSyncRun {
  id                String                                 @id @default(cuid())
  agentId           String
  agent             Agent                                  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  connectorDeviceId String?
  connectorDevice   NationalLifeConnectorDevice?           @relation(fields: [connectorDeviceId], references: [id], onDelete: SetNull)
  deploymentScope   String                                 @default("SINGLE_DEPLOYMENT")
  provider          String                                 @default("NATIONAL_LIFE")
  executionSource   String                                 @default("REMOTE")
  state             NationalLifeSyncRunState               @default(QUEUED)
  totalStages       Int
  completedStages   Int                                    @default(0)
  failedStages      Int                                    @default(0)
  currentGridKey    String?
  /// As grades que este run planejou ler. Vazio significa "o par padrão legado"
  /// (NEW_BUSINESS, INFORCE_CLIENTS): runs criados antes desta coluna só podiam
  /// ter planejado essas duas, então nenhum backfill é necessário. É a autoridade
  /// do servidor sobre quais estágios pertencem a este run — sem ela o dispositivo
  /// decidiria o que conta como completo.
  plannedGridKeys   String[]                               @default([])
  safeErrorCode     String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime                               @default(now())
  updatedAt         DateTime                               @updatedAt
  jobs              BrowserAutomationJob[]
  stageReceipts     NationalLifeConnectorStageReceipt[]
  stageCompletions  NationalLifeConnectorStageCompletion[]
  stageFailures     NationalLifeConnectorStageFailure[]
  rawGridPages      NationalLifeRawGridPage[]
  exportUploads     NationalLifeExportUpload[]

  @@index([agentId, deploymentScope, state, createdAt])
  @@index([connectorDeviceId, createdAt])
  /// Serve a varredura de recibos de estágio, que seleciona por run terminal
  /// parado há mais de 30 dias. O índice de cima não serve: ele começa por
  /// `agentId`, e a varredura não filtra por agente nenhum — é a tabela inteira.
  @@index([state, updatedAt])
}

model NationalLifeConnectorPairing {
  id         String    @id @default(cuid())
  codeHash   String    @unique
  agentId    String
  agent      Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([agentId, expiresAt])
  /// Dois índices de uma coluna, e não um composto: a varredura procura
  /// `expiresAt < corte` **ou** `consumedAt < corte`, e o Postgres resolve isso
  /// com um BitmapOr dos dois. Um composto `(expiresAt, consumedAt)` só serviria
  /// ao primeiro ramo. O `@@index([agentId, expiresAt])` acima não serve a
  /// nenhum: começa por `agentId`, que a varredura não filtra.
  @@index([expiresAt])
  @@index([consumedAt])
}

model NationalLifeConnectorDevice {
  id                  String                                 @id @default(cuid())
  agentId             String
  agent               Agent                                  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  label               String
  publicKeyJwk        Json
  publicKeyThumbprint String                                 @unique
  status              String                                 @default("ACTIVE")
  lastSeenAt          DateTime?
  revokedAt           DateTime?
  createdAt           DateTime                               @default(now())
  updatedAt           DateTime                               @updatedAt
  replays             NationalLifeConnectorReplay[]
  stageReceipts       NationalLifeConnectorStageReceipt[]
  stageCompletions    NationalLifeConnectorStageCompletion[]
  stageFailures       NationalLifeConnectorStageFailure[]
  syncRuns            NationalLifeSyncRun[]
  commands            NationalLifeConnectorCommand[]
  exportUploads       NationalLifeExportUpload[]

  @@index([agentId, status])
}

/// Durable command ledger for both local Chrome and remote-browser execution.
/// The payload is only the declared command parameters; carrier responses are
/// stored as events and must remain redacted by the command-specific executor.
model NationalLifeConnectorCommand {
  id                   String                                    @id @default(cuid())
  agentId              String
  agent                Agent                                     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deviceId             String?
  device               NationalLifeConnectorDevice?              @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  protocolVersion      Int
  runId                String
  capability           String
  state                NationalLifeConnectorCommandState         @default(QUEUED)
  target               Json?
  params               Json
  payloadHash          String
  idempotencyKey       String
  requiresConfirmation Boolean                                   @default(false)
  confirmationState    NationalLifeConnectorConfirmationState    @default(NOT_REQUIRED)
  safeErrorCode        String?
  expiresAt            DateTime
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime                                  @default(now())
  updatedAt            DateTime                                  @updatedAt
  events               NationalLifeConnectorCommandEvent[]
  confirmation         NationalLifeConnectorCommandConfirmation?

  @@unique([agentId, idempotencyKey])
  @@index([agentId, state, createdAt])
  @@index([deviceId, state, createdAt])
  @@index([expiresAt])
}

model NationalLifeConnectorCommandEvent {
  id            String                       @id @default(cuid())
  commandId     String
  command       NationalLifeConnectorCommand @relation(fields: [commandId], references: [id], onDelete: Cascade)
  sequence      Int
  type          String
  payload       Json?
  safeErrorCode String?
  createdAt     DateTime                     @default(now())

  @@unique([commandId, sequence])
  @@index([commandId, createdAt])
}

model NationalLifeConnectorCommandConfirmation {
  id                String                                 @id @default(cuid())
  commandId         String                                 @unique
  command           NationalLifeConnectorCommand           @relation(fields: [commandId], references: [id], onDelete: Cascade)
  payloadHash       String
  state             NationalLifeConnectorConfirmationState @default(PENDING)
  confirmedByUserId String?
  confirmedAt       DateTime?
  rejectedAt        DateTime?
  expiresAt         DateTime
  createdAt         DateTime                               @default(now())
  updatedAt         DateTime                               @updatedAt

  @@index([state, expiresAt])
}

model NationalLifeConnectorReplay {
  id        String                      @id @default(cuid())
  deviceId  String
  device    NationalLifeConnectorDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  jti       String
  expiresAt DateTime
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt

  @@unique([deviceId, jti])
  @@index([expiresAt])
}

model NationalLifeConnectorStageReceipt {
  id             String                      @id @default(cuid())
  deviceId       String
  device         NationalLifeConnectorDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  runId          String
  run            NationalLifeSyncRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  gridKey        String
  sequence       Int
  /// Offset da página no portal. Mantido junto do recibo para que a extensão
  /// possa continuar uma fase interrompida sem voltar ao início da grade.
  sourceOffset   Int                         @default(0)
  /// Primeiro offset que ainda não foi enviado depois deste lote/página.
  nextOffset     Int                         @default(0)
  truncated      Boolean                     @default(true)
  contentHash    String
  /// Linhas recebidas na página. Não entra no hash de conteúdo — este é o sha256
  /// do corpo cru. O que fixa seu significado é ser campo público do recibo e,
  /// junto de `writtenCount`, tornar visível "recebi 200, escrevi 0".
  recordCount    Int
  /// Linhas efetivamente escritas depois da normalização. Nulo em recibos
  /// anteriores a esta coluna. Distingue "recebi 200, escrevi 0" — uma página que
  /// o mapeador descartou inteira — de uma página vazia de verdade.
  writtenCount   Int?
  /// Linhas repetidas dentro do lote, removidas pela chave estável antes do
  /// upsert. Repetições entre lotes continuam protegidas pela chave única do
  /// modelo normalizado e pelo idempotency key do recibo.
  duplicateCount Int                      @default(0)
  /// Linhas sem uma chave mínima para a entidade normalizada. A cópia raw da
  /// página continua preservada para auditoria e remapeamento futuro.
  rejectedCount  Int                      @default(0)
  idempotencyKey String                      @unique
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@unique([deviceId, runId, gridKey, sequence])
  @@index([runId, gridKey])
  @@index([runId, truncated])
}

/// A completion is deliberately separate from a page receipt. A receipt proves
/// that one batch landed; it cannot prove that the carrier's final page landed.
/// The connector writes this only after it has uploaded every sequence and the
/// server has reconciled the raw count against the carrier's recordsTotal.
model NationalLifeConnectorStageCompletion {
  id                  String                      @id @default(cuid())
  deviceId            String
  device              NationalLifeConnectorDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  runId               String
  run                 NationalLifeSyncRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  gridKey             String
  expectedRecordCount Int
  receivedRecordCount Int
  finalSequence       Int
  truncated           Boolean                     @default(false)
  completedAt         DateTime                    @default(now())

  @@unique([deviceId, runId, gridKey])
  @@index([runId, gridKey])
}

/// A source failure is a durable, isolated outcome, not a failure of the whole
/// run. `resolvedAt` preserves the attempt while letting a retry make the source
/// pending again without rereading stages that already have completion receipts.
model NationalLifeConnectorStageFailure {
  id            String                      @id @default(cuid())
  deviceId      String
  device        NationalLifeConnectorDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  runId         String
  run           NationalLifeSyncRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  gridKey       String
  safeErrorCode String
  retryable     Boolean                     @default(true)
  failedAt      DateTime                    @default(now())
  resolvedAt    DateTime?
  updatedAt     DateTime                    @updatedAt

  @@unique([deviceId, runId, gridKey])
  @@index([runId, resolvedAt])
}

/// Private, resumable landing zone for official carrier exports. The web UI
/// only receives normalized rows and provenance after validation succeeds.
model NationalLifeExportUpload {
  id             String                      @id @default(cuid())
  agentId        String
  agent          Agent                       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deviceId       String
  device         NationalLifeConnectorDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  runId          String
  run            NationalLifeSyncRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceKey      String
  fileName       String
  contentType    String
  expectedBytes  Int
  expectedSha256 String
  totalChunks    Int
  state          String                      @default("UPLOADING")
  receivedBytes  Int                         @default(0)
  receivedChunks Int                         @default(0)
  rowCount       Int?
  writtenCount   Int?
  safeErrorCode  String?
  fileBytes      Bytes?
  completedAt    DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  chunks         NationalLifeExportChunk[]

  @@unique([deviceId, runId, sourceKey])
  @@index([agentId, createdAt])
  @@index([state, updatedAt])
}

model NationalLifeExportChunk {
  id          String                   @id @default(cuid())
  uploadId    String
  upload      NationalLifeExportUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  sequence    Int
  byteOffset  Int
  byteLength  Int
  contentHash String
  bytes       Bytes
  createdAt   DateTime                 @default(now())

  @@unique([uploadId, sequence])
  @@index([uploadId, byteOffset])
}

model Illustration {
  id                 String                 @id @default(cuid())
  // A quote is pre-sale: the insured is a prospect who has no case and often no
  // client record either. Requiring a case made the table impossible to write
  // to — it stayed empty from the day it was created.
  caseId             String?
  insuranceCase      InsuranceCase?         @relation(fields: [caseId], references: [id])
  clientId           String?
  client             Client?                @relation(fields: [clientId], references: [id])
  // Always known, and the only thing that scopes a quote to who may read it.
  agentId            String
  agent              Agent                  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  kind               IllustrationKind
  provider           String?
  externalId         String?
  sourceUpdatedAt    DateTime?
  productName        String?
  faceAmount         Decimal?
  premium            Decimal?
  // Held on the illustration rather than only through a relation, so a quote
  // for someone who is not in the system yet still says who it was for.
  insuredName        String?
  insuredDateOfBirth DateTime?
  documentUrl        String?
  // The illustration PDF as the carrier rendered it. Held as bytes rather than
  // on disk because the carrier runtime is a separate container from the web
  // app, so a file written there is not readable here; at ~1.5 MB a document
  // and this volume that is a fair trade, and moving to object storage later
  // does not change how a caller asks for it.
  documentBytes      Bytes?
  documentMimeType   String?
  documentFetchedAt  DateTime?
  rawPayload         Json?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  scenarios          IllustrationScenario[]

  @@unique([provider, externalId])
  @@index([caseId])
  @@index([agentId, createdAt])
  @@index([clientId])
}

model IllustrationScenario {
  id             String       @id @default(cuid())
  illustrationId String
  illustration   Illustration @relation(fields: [illustrationId], references: [id])
  name           String
  assumptions    Json?
  summary        Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([illustrationId])
}

model Application {
  id              String                   @id @default(cuid())
  caseId          String
  insuranceCase   InsuranceCase            @relation(fields: [caseId], references: [id])
  status          ApplicationStatus        @default(DRAFT)
  provider        String?
  externalId      String?
  sourceUpdatedAt DateTime?
  submittedAt     DateTime?
  rawPayload      Json?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  requirements    ApplicationRequirement[]

  @@unique([provider, externalId])
  @@index([caseId])
}

model ApplicationRequirement {
  id              String            @id @default(cuid())
  applicationId   String
  application     Application       @relation(fields: [applicationId], references: [id])
  status          RequirementStatus @default(OPEN)
  title           String
  description     String?
  dueAt           DateTime?
  receivedAt      DateTime?
  provider        String?
  externalId      String?
  sourceUpdatedAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([provider, externalId])
  @@index([applicationId, status])
}

model CaseTimelineEvent {
  id            String        @id @default(cuid())
  caseId        String
  insuranceCase InsuranceCase @relation(fields: [caseId], references: [id])
  type          String
  title         String
  body          String?
  metadata      Json?
  dueAt         DateTime?
  doneAt        DateTime?
  createdAt     DateTime      @default(now())

  @@index([caseId, createdAt])
}

model PolicySnapshot {
  id              String       @id @default(cuid())
  policyId        String
  policy          Policy       @relation(fields: [policyId], references: [id])
  status          PolicyStatus
  faceAmount      Decimal?
  plannedPremium  Decimal?
  lastPaymentDate DateTime?
  observedAt      DateTime     @default(now())
  provider        String?
  externalId      String?
  sourceUpdatedAt DateTime?
  rawPayload      Json?
  createdAt       DateTime     @default(now())

  @@unique([provider, externalId])
  @@index([policyId, observedAt])
}

model PolicyTransaction {
  id              String                @id @default(cuid())
  policyId        String
  policy          Policy                @relation(fields: [policyId], references: [id])
  type            PolicyTransactionType
  amount          Decimal
  occurredAt      DateTime
  provider        String?
  externalId      String?
  sourceUpdatedAt DateTime?
  rawPayload      Json?
  createdAt       DateTime              @default(now())

  @@unique([provider, externalId])
  @@index([policyId, occurredAt])
}

model CommissionTransaction {
  id                    String                    @id @default(cuid())
  policyId              String
  policy                Policy                    @relation(fields: [policyId], references: [id])
  agentId               String
  agent                 Agent                     @relation(fields: [agentId], references: [id])
  type                  CommissionTransactionType
  amount                Decimal
  occurredAt            DateTime
  provider              String?
  externalId            String?
  sourceTransactionId   String?
  sourceUpdatedAt       DateTime?
  originalTransactionId String?
  rawPayload            Json?
  createdAt             DateTime                  @default(now())

  @@unique([provider, externalId])
  @@unique([provider, sourceTransactionId])
  @@index([policyId, occurredAt])
  @@index([agentId, occurredAt])
}

model PolicyReview {
  id          String    @id @default(cuid())
  policyId    String
  policy      Policy    @relation(fields: [policyId], references: [id])
  dueAt       DateTime
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([policyId])
  @@index([dueAt])
}

model IntegrationConnection {
  id            String      @id @default(cuid())
  provider      String      @unique
  status        SyncStatus  @default(PENDING)
  isEnabled     Boolean     @default(false)
  configuration Json?
  lastSyncedAt  DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  syncEvents    SyncEvent[]
}

model ExternalReference {
  id              String    @id @default(cuid())
  entityType      String
  entityId        String
  provider        String
  externalId      String
  sourceUpdatedAt DateTime?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([provider, externalId])
  @@index([entityType, entityId])
}

model SyncEvent {
  id                      String                 @id @default(cuid())
  integrationConnectionId String?
  integrationConnection   IntegrationConnection? @relation(fields: [integrationConnectionId], references: [id])
  provider                String
  externalId              String
  sourceUpdatedAt         DateTime?
  direction               String
  eventType               String
  status                  SyncStatus             @default(PENDING)
  payload                 Json?
  attemptCount            Int                    @default(0)
  lastError               String?
  processedAt             DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@unique([provider, externalId])
  @@index([integrationConnectionId, status])
}

model CommissionPlan {
  id              String  @id @default(cuid())
