  downlineLevel   Int
  overridePercent Decimal

  @@unique([rank, downlineLevel])
}

model CommissionRecord {
  id            String         @id @default(cuid())
  policyId      String
  policy        Policy         @relation(fields: [policyId], references: [id])
  agentId       String
  agent         Agent          @relation(fields: [agentId], references: [id])
  amount        Decimal
