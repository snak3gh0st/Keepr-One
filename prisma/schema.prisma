/// Append-only ledger of promotion-production events.
///
/// `creditedPc` is the signed delta recognized at `recognizedAt`; it is not a
/// commission amount. A correction or reversal is a new row linked through
/// `supersedesCreditId`, so the facts that produced an earlier rank never move.
model PromotionCredit {
  id                       String                       @id @default(cuid())
  carrier                  String
  source                   String
  externalId               String
  policyNumber             String?
  producerAgentId          String
  producerAgent            Agent                        @relation("PromotionCreditProducer", fields: [producerAgentId], references: [id], onDelete: Restrict)
  targetPremium            Decimal?
  anticipatedAnnualPremium Decimal?
  qualificationWeight      Decimal?
  creditedPc               Decimal
  status                   PromotionCreditStatus
  recognizedAt             DateTime
  supersedesCreditId       String?
  supersedesCredit         PromotionCredit?             @relation("PromotionCreditSupersession", fields: [supersedesCreditId], references: [id], onDelete: Restrict)
  supersededBy             PromotionCredit[]            @relation("PromotionCreditSupersession")
  rawPayload               Json?
  createdAt                DateTime                     @default(now())
  attributions             PromotionCreditAttribution[]

  /// Carrier + source surface + carrier event id is the idempotency boundary.
  /// Agent id is intentionally absent: replaying one event under another agent
  /// must conflict instead of silently duplicating production.
  @@unique([carrier, source, externalId])
  @@index([producerAgentId, recognizedAt])
  @@index([status, recognizedAt])
  @@index([policyNumber, recognizedAt])
  @@index([supersedesCreditId])
}

/// Frozen ownership of one promotion event. Every credit has one PERSONAL row
/// and may have one AGENCY row per eligible upline. Each agency row preserves
/// one leader who owned the producer when the event landed, even if any level of
/// the hierarchy changes later. Partial unique indexes in the migration enforce
/// one personal row and one agency row per leader.
model PromotionCreditAttribution {
  id                String                         @id @default(cuid())
  promotionCreditId String
  promotionCredit   PromotionCredit                @relation(fields: [promotionCreditId], references: [id], onDelete: Restrict)
  kind              PromotionCreditAttributionKind
  agentId           String
  agent             Agent                          @relation("PromotionCreditAttributedAgent", fields: [agentId], references: [id], onDelete: Restrict)
  leaderAgentId     String?
  leaderAgent       Agent?                         @relation("PromotionCreditAttributionLeader", fields: [leaderAgentId], references: [id], onDelete: Restrict)
  frozenAt          DateTime                       @default(now())

  @@index([promotionCreditId, kind])
  @@index([agentId, kind])
  @@index([leaderAgentId, kind])
}

/// Durable record of the highest ranks an agent has earned. Rolling production
/// may later fall outside the active 12-month window without erasing a jacket or
/// title already achieved; only an explicit invalidation changes that history.
model PromotionAchievement {
  id                    String                    @id @default(cuid())
  agentId               String
  agent                 Agent                     @relation(fields: [agentId], references: [id], onDelete: Restrict)
  rankId                String
  step                  Int
  route                 PromotionAchievementRoute
  achievedAt            DateTime
  qualifyingWindowStart DateTime
  qualifyingWindowEnd   DateTime
  personalPc            Decimal
  agencyPc              Decimal
  ruleSetVersion        String
  invalidatedAt         DateTime?
  invalidationReason    String?
  createdAt             DateTime                  @default(now())

  /// The migration enforces one active row with a partial unique index on
  /// (agentId, rankId) WHERE invalidatedAt IS NULL. Historical invalidated rows
  /// remain queryable and the same rank may be earned again later.
  @@index([agentId, rankId])
  @@index([agentId, step])
}

