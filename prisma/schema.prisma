// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENT
  CLIENT
}

enum AgentStatus {
  ACTIVE
  INACTIVE
}

enum PolicyStatus {
  PENDING
  APPROVED
  INFORCE
  LAPSED
  CANCELLED
}

enum CommissionType {
  DIRECT
  OVERRIDE
}

enum ImportType {
  POLICIES
  COMMISSIONS
}

enum ImportStatus {
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum CaseStage {
  LEAD
  DISCOVERY
  DESIGN
  ILLUSTRATION_READY
  APPLICATION_STARTED
  SUBMITTED
  UNDERWRITING
  APPROVED
  ISSUED
  PLACED
  DECLINED
  WITHDRAWN
}

enum CaseStatus {
  OPEN
  CLOSED
}

enum IllustrationKind {
  PRELIMINARY
  OFFICIAL
}

enum ApplicationStatus {
  DRAFT
  STARTED
  SUBMITTED
  UNDERWRITING
  APPROVED
  ISSUED
  DECLINED
  WITHDRAWN
}

enum RequirementStatus {
  OPEN
  RECEIVED
  WAIVED
}

enum PolicyTransactionType {
  PREMIUM
  CHARGE
  LOAN
  WITHDRAWAL
  ADJUSTMENT
}

enum CommissionTransactionType {
  EXPECTED
  PAID
  CHARGEBACK
  ADJUSTMENT
}

enum SyncStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  NEEDS_REVIEW
}

enum BrowserJobState {
  QUEUED
  RUNNING
  ACTION_REQUIRED
  WAITING_FOR_MFA
  WAITING_FOR_REVIEW
  RETRYABLE
  CREDENTIALS_EXPIRED
  MANUAL_REVIEW
  SUCCEEDED
  FAILED
  CANCELLED
}

enum BrowserJobOperation {
  TEST_CONNECTION
  SYNC_CASE_READ
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role
  createdAt DateTime @default(now())

  agent             Agent?
  client            Client?
  imports           ImportBatch[]
  auditLogs         AuditLog[]
  emailVerified     Boolean            @default(false)
  image             String?
  updatedAt         DateTime           @updatedAt
  sessions          Session[]
  accounts          Account[]
  uploadedDocuments PolicyDocument[]

  @@map("user")
}

model Agent {
  id            String      @id @default(cuid())
  userId        String      @unique
  user          User        @relation(fields: [userId], references: [id])
  parentAgentId String?
  parentAgent   Agent?      @relation("AgentHierarchy", fields: [parentAgentId], references: [id])
  subAgents     Agent[]     @relation("AgentHierarchy")
  rank          String
  npn           String?     @unique
  status        AgentStatus @default(ACTIVE)
  createdAt     DateTime    @default(now())

  clients           Client[]
  policies          Policy[]
  commissionRecords CommissionRecord[]
  prospects         Prospect[]
  insuranceCases    InsuranceCase[]
  commissionTransactions CommissionTransaction[]
  integrationCredentials AgentIntegrationCredential[]
  integrationSessions    AgentIntegrationSession[]
  nationalLifeConnectionAttempts NationalLifeConnectionAttempt[]
  browserJobs            BrowserAutomationJob[]
  nationalLifeCaseSnapshots NationalLifeCaseSnapshot[]
  nationalLifeInforcePolicies NationalLifeInforcePolicy[]
  nationalLifeReportRows NationalLifeReportRow[]

  @@index([parentAgentId])
}

/// Raw landing zone for rows read from the National Life agent portal grids.
/// Deliberately not mapped into Prospect/InsuranceCase/Application yet: that
/// mapping is a separate decision, and Policy still holds synthetic seed rows.
/// `raw` keeps the untouched carrier payload so no field is lost to normalisation.
model NationalLifeCaseSnapshot {
  id                       String   @id @default(cuid())
  agentId                  String
  agent                    Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deploymentScope          String
  gridKey                  String
  policyNo                 String
  insuredName              String?
  ownerName                String?
  product                  String?
  carrierStatus            String?
  deliveryStatus           String?
  actionRequired           String?
  requirements             String?
  submitDate               String?
  sentDate                 String?
  modalPremium             String?
  anticipatedAnnualPremium String?
  submitMethod             String?
  caseManager              String?
  agency                   String?
  writingAgentName         String?
  writingAgentNumber       String?
  companyCode              String?
  raw                      Json
  fetchedAt                DateTime
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([agentId, deploymentScope, gridKey, policyNo])
  @@index([agentId, gridKey])
  @@index([fetchedAt])
}

/// Raw landing zone for the inforce book grid. Distinct from
/// NationalLifeCaseSnapshot: this is policy/client demographic data (owner and
/// insured name, DOB, address, contact, cash value), not a submission-pipeline
/// case, and the carrier's own field names differ (PolicyNumber, not PolicyNo).
/// Contains real client PII, stored in plaintext to match how Client already
/// stores name/email/phone in this schema — same trust boundary, no new gap.
model NationalLifeInforcePolicy {
  id                    String   @id @default(cuid())
  agentId               String
  agent                 Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deploymentScope       String
  policyNumber          String
  nbPolicyNumber        String?
  policyStatus          String?
  policyIssueDate       String?
  lastStatusChangeDate  String?
  productClass          String?
  productName           String?
  productCode           String?
  companyCode           String?
  systemCode            String?
  planCode              String?
  agentNumber           String?
  agentName             String?
  servicingAgentName    String?
  servicingAgencyName   String?
  insuredClientName     String?
  insuredDob            String?
  insuredEmail          String?
  insuredPhoneNumber    String?
  ownerClientName       String?
  ownerDob              String?
  ownerEmail            String?
  ownerPhoneNumber      String?
  accumulatedCashValue  String?
  anticipatedAnnualPremium String?
  termConversionDate    String?
  levelPeriodEndDate    String?
  employerName          String?
  raw                   Json
  fetchedAt             DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([agentId, deploymentScope, policyNumber])
  @@index([agentId])
  @@index([fetchedAt])
}

/// Generic landing zone for the portal's report grids — paid commissions,
/// projected commissions, and whatever else is mapped later.
///
/// One table rather than one per report: these are statement-level summaries (8
/// and 4 rows respectively, not transaction ledgers) whose columns differ
/// completely from each other, so typed columns per report would be mostly nulls.
/// `raw` holds the carrier row verbatim and `amounts` the numeric fields pulled
/// out of it, which is what a front end needs without a migration per report.
model NationalLifeReportRow {
  id              String   @id @default(cuid())
  agentId         String
  agent           Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deploymentScope String
  gridKey         String
  /// Deterministic per-report identity, so a re-sync updates instead of duplicating.
  rowKey          String
  primaryDate     String?
  label           String?
  amounts         Json
  raw             Json
  fetchedAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([agentId, deploymentScope, gridKey, rowKey])
  @@index([agentId, gridKey])
  @@index([fetchedAt])
}

model Client {
  id              String   @id @default(cuid())
  userId          String?  @unique
  user            User?    @relation(fields: [userId], references: [id])
  name            String
  email           String?
  phone           String?
  // The carrier reports it on every inforce policy, for 98% of the book. Stored
  // as a date rather than the carrier's MM/DD/YYYY string so age and birthdays
  // are computable instead of needing to be re-parsed at every call site.
  dateOfBirth     DateTime?
  assignedAgentId String
  assignedAgent   Agent    @relation(fields: [assignedAgentId], references: [id])
  createdAt       DateTime @default(now())

  policies Policy[]
  insuranceCases InsuranceCase[]

  @@index([assignedAgentId])
}

model Policy {
  id            String       @id @default(cuid())
  clientId      String
  client        Client       @relation(fields: [clientId], references: [id])
  agentId       String
  agent         Agent        @relation(fields: [agentId], references: [id])
  carrier       String
  product       String
  policyNumber  String       @unique
  faceAmount    Decimal
  // The modal premium — what the client actually pays each time — kept with the
  // mode it is paid in. Annualising on write would destroy the distinction the
  // client chose: $250 monthly and $250 annual are different policies.
  premium       Decimal
  premiumMode   String?
  status        PolicyStatus
  effectiveDate DateTime?
  lastPaymentDate DateTime?
  statusChangedAt DateTime?
  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])
  caseId        String?
  case          InsuranceCase? @relation(fields: [caseId], references: [id])
  sourceProvider String?
  sourceExternalId String?
  sourceUpdatedAt DateTime?
  createdAt     DateTime     @default(now())

  commissionRecords CommissionRecord[]
  documents         PolicyDocument[]
  snapshots         PolicySnapshot[]
  transactions      PolicyTransaction[]
  commissionTransactions CommissionTransaction[]
  reviews           PolicyReview[]

  @@index([agentId])
  @@index([clientId])
  @@index([caseId])
  @@unique([sourceProvider, sourceExternalId])
}

model Prospect {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  email           String?
  phone           String?
  dateOfBirth     DateTime?
  state           String?
  tobaccoStatus   String?
  assignedAgentId String
  assignedAgent   Agent    @relation(fields: [assignedAgentId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  cases           InsuranceCase[]

  @@index([assignedAgentId])
}

model InsuranceCase {
  id              String      @id @default(cuid())
  prospectId      String
  prospect        Prospect    @relation(fields: [prospectId], references: [id])
  assignedAgentId String
  assignedAgent   Agent       @relation(fields: [assignedAgentId], references: [id])
  clientId        String?
  client          Client?     @relation(fields: [clientId], references: [id])
  stage           CaseStage   @default(LEAD)
  status          CaseStatus  @default(OPEN)
  objective       String?
  targetCoverage  Decimal?
  monthlyBudget   Decimal?
  needsAnalysis   Json?
  carrier         String?
  productType     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  illustrations   Illustration[]
  applications    Application[]
  timelineEvents  CaseTimelineEvent[]
  policies        Policy[]
  browserJobs     BrowserAutomationJob[]

  @@index([assignedAgentId, stage])
  @@index([prospectId])
  @@index([clientId])
}

model AgentIntegrationCredential {
  id              String   @id @default(cuid())
  agentId         String
  agent           Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  provider        String
  maskedUsername  String
  keyVersion      String
  algorithm       String
  iv              String
  ciphertext      String
  authTag         String
  status          String   @default("UNTESTED")
  lastTestedAt    DateTime?
  lastSucceededAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([agentId, provider])
  @@index([provider, status])
}

model AgentIntegrationSession {
  id                 String   @id @default(cuid())
  agentId            String
  agent              Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deploymentScope    String   @default("SINGLE_DEPLOYMENT")
  provider           String
  purpose            String   @default("CARRIER_SESSION")
  status             String   @default("CONNECTED")
  formatVersion      Int      @default(1)
  keyVersion         String?
  algorithm          String?
  iv                 String?
  ciphertext         String?
  authTag            String?
  carrierExpiresAt   DateTime?
  lastConnectedAt    DateTime
  lastUsedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([agentId, deploymentScope, provider, purpose])
  @@index([provider, status])
}

model NationalLifeConnectionAttempt {
  id                String   @id @default(cuid())
  agentId           String
  agent             Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deploymentScope   String   @default("SINGLE_DEPLOYMENT")
  provider          String
  purpose           String   @default("INTERACTIVE_CONNECTION_ATTEMPT")
  state             String
  formatVersion     Int      @default(1)
  runtimeKeyVersion String?
  runtimeAlgorithm  String?
  runtimeIv         String?
  runtimeCiphertext String?
  runtimeAuthTag    String?
  viewerNonceHash   String?
  currentOrigin     String?
  safeErrorCode     String?
  leaseOwner        String?
  leaseExpiresAt    DateTime?
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([agentId, deploymentScope, provider, purpose])
  @@index([state, expiresAt])
  @@index([leaseExpiresAt])
}

model BrowserAutomationJob {
  id                     String              @id @default(cuid())
  agentId                String
  agent                  Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  caseId                 String?
  insuranceCase          InsuranceCase?      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  provider               String
  operation              BrowserJobOperation
  state                  BrowserJobState     @default(QUEUED)
  idempotencyKey         String              @unique
  input                  Json
  result                 Json?
  safeErrorCode          String?
  safeErrorDetail        Json?
  attemptCount           Int                 @default(0)
  availableAt            DateTime            @default(now())
  leaseOwner             String?
  leaseExpiresAt         DateTime?
  continuationKeyVersion String?
  continuationIv         String?
  continuationCiphertext String?
  continuationAuthTag    String?
  continuationExpiresAt  DateTime?
  startedAt              DateTime?
  finishedAt             DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([state, availableAt])
  @@index([agentId, createdAt])
  @@index([caseId, createdAt])
}

model Illustration {
  id              String           @id @default(cuid())
  caseId          String
  insuranceCase   InsuranceCase    @relation(fields: [caseId], references: [id])
  kind            IllustrationKind
  provider        String?
  externalId      String?
  sourceUpdatedAt DateTime?
  productName     String?
  faceAmount      Decimal?
  premium         Decimal?
  documentUrl     String?
  rawPayload      Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  scenarios       IllustrationScenario[]

  @@index([caseId])
  @@unique([provider, externalId])
}

model IllustrationScenario {
  id             String       @id @default(cuid())
  illustrationId String
  illustration   Illustration @relation(fields: [illustrationId], references: [id])
  name           String
  assumptions    Json?
  summary        Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([illustrationId])
}

model Application {
  id              String            @id @default(cuid())
  caseId          String
  insuranceCase   InsuranceCase     @relation(fields: [caseId], references: [id])
  status          ApplicationStatus @default(DRAFT)
  provider        String?
  externalId      String?
  sourceUpdatedAt DateTime?
  submittedAt     DateTime?
  rawPayload      Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  requirements    ApplicationRequirement[]

  @@index([caseId])
  @@unique([provider, externalId])
}

model ApplicationRequirement {
  id              String            @id @default(cuid())
  applicationId   String
  application     Application       @relation(fields: [applicationId], references: [id])
  status          RequirementStatus @default(OPEN)
  title           String
  description     String?
  dueAt           DateTime?
  receivedAt      DateTime?
  provider        String?
  externalId      String?
  sourceUpdatedAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([applicationId, status])
  @@unique([provider, externalId])
}

model CaseTimelineEvent {
  id        String        @id @default(cuid())
  caseId    String
  insuranceCase InsuranceCase @relation(fields: [caseId], references: [id])
  type      String
  title     String
  body      String?
  metadata  Json?
  dueAt     DateTime?
  doneAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([caseId, createdAt])
}

model PolicySnapshot {
  id              String   @id @default(cuid())
  policyId        String
  policy          Policy   @relation(fields: [policyId], references: [id])
  status          PolicyStatus
  faceAmount      Decimal?
  plannedPremium  Decimal?
  lastPaymentDate DateTime?
  observedAt      DateTime @default(now())
  provider        String?
  externalId      String?
  sourceUpdatedAt DateTime?
  rawPayload      Json?
  createdAt       DateTime @default(now())

  @@index([policyId, observedAt])
  @@unique([provider, externalId])
}

model PolicyTransaction {
  id              String                @id @default(cuid())
  policyId        String
  policy          Policy                @relation(fields: [policyId], references: [id])
  type            PolicyTransactionType
  amount          Decimal
  occurredAt      DateTime
  provider        String?
  externalId      String?
  sourceUpdatedAt DateTime?
  rawPayload      Json?
  createdAt       DateTime              @default(now())

  @@index([policyId, occurredAt])
  @@unique([provider, externalId])
}

model CommissionTransaction {
  id                  String                    @id @default(cuid())
  policyId            String
  policy              Policy                    @relation(fields: [policyId], references: [id])
  agentId             String
  agent               Agent                     @relation(fields: [agentId], references: [id])
  type                CommissionTransactionType
  amount              Decimal
  occurredAt          DateTime
  provider            String?
  externalId          String?
  sourceTransactionId String?
  sourceUpdatedAt     DateTime?
  originalTransactionId String?
  rawPayload          Json?
  createdAt           DateTime                  @default(now())

  @@index([policyId, occurredAt])
  @@index([agentId, occurredAt])
  @@unique([provider, externalId])
  @@unique([provider, sourceTransactionId])
}

model PolicyReview {
  id          String    @id @default(cuid())
  policyId    String
  policy      Policy    @relation(fields: [policyId], references: [id])
  dueAt       DateTime
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([policyId])
  @@index([dueAt])
}

model IntegrationConnection {
  id             String     @id @default(cuid())
  provider       String     @unique
  status         SyncStatus @default(PENDING)
  isEnabled      Boolean    @default(false)
  configuration  Json?
  lastSyncedAt   DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  syncEvents     SyncEvent[]
}

model ExternalReference {
  id              String   @id @default(cuid())
  entityType      String
  entityId        String
  provider        String
  externalId      String
  sourceUpdatedAt DateTime?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([entityType, entityId])
  @@unique([provider, externalId])
}

model SyncEvent {
  id                      String                 @id @default(cuid())
  integrationConnectionId String?
  integrationConnection   IntegrationConnection? @relation(fields: [integrationConnectionId], references: [id])
  provider                String
  externalId              String
  sourceUpdatedAt         DateTime?
  direction               String
  eventType               String
  status                  SyncStatus             @default(PENDING)
  payload                 Json?
  attemptCount            Int                    @default(0)
  lastError               String?
  processedAt             DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@index([integrationConnectionId, status])
  @@unique([provider, externalId])
}

model CommissionPlan {
  id              String  @id @default(cuid())
  rank            String
  downlineLevel   Int
  overridePercent Decimal

  @@unique([rank, downlineLevel])
}

model CommissionRecord {
  id            String         @id @default(cuid())
  policyId      String
  policy        Policy         @relation(fields: [policyId], references: [id])
  agentId       String
  agent         Agent          @relation(fields: [agentId], references: [id])
  amount        Decimal
  type          CommissionType
  level         Int            @default(0)
  period        String
  importBatchId String?
  importBatch   ImportBatch?   @relation(fields: [importBatchId], references: [id])
  createdAt     DateTime       @default(now())

  @@unique([policyId, agentId, period, type, level])
  @@index([agentId])
  @@index([policyId])
}

model ImportBatch {
  id           String       @id @default(cuid())
  uploadedById String
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
  filename     String
  type         ImportType
  status       ImportStatus @default(PROCESSING)
  rowErrors    Json?
  createdAt    DateTime     @default(now())

  policies          Policy[]
  commissionRecords CommissionRecord[]
}

model PolicyDocument {
  id           String   @id @default(cuid())
  policyId     String
  policy       Policy   @relation(fields: [policyId], references: [id])
  filename     String
  storedPath   String
  mimeType     String
  sizeBytes    Int
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([policyId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
