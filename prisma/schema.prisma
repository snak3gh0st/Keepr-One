// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENT
  CLIENT
}

enum AgentStatus {
  ACTIVE
  INACTIVE
}

enum MessagingChannelProvider {
  EVOLUTION
  META_CLOUD
  CHATWOOT_EMAIL
  OTHER
}

enum MessagingChannelKind {
  WHATSAPP
  EMAIL
  SMS
  INSTAGRAM
  OTHER
}

enum MessagingChannelStatus {
  PROVISIONING
  WAITING_FOR_USER
  CONNECTED
  DEGRADED
  DISCONNECTED
  FAILED
}

enum PolicyStatus {
  PENDING
  APPROVED
  INFORCE
  LAPSED
  CANCELLED
}

enum CommissionType {
  DIRECT
  OVERRIDE
}

enum ImportType {
  POLICIES
  COMMISSIONS
}

enum ImportStatus {
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum CaseStage {
  LEAD
  DISCOVERY
  DESIGN
  ILLUSTRATION_READY
  APPLICATION_STARTED
  SUBMITTED
  UNDERWRITING
  APPROVED
  ISSUED
  PLACED
  DECLINED
  WITHDRAWN
}

enum CaseStatus {
  OPEN
  CLOSED
}

enum FollowUpStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum CalendarProvider {
  GOOGLE
}

enum CalendarIntegrationStatus {
  CONNECTED
  RECONNECT_REQUIRED
  ERROR
  DISCONNECTED
}

enum CalendarSyncStatus {
  SYNCED
  PENDING
  PROCESSING
  ERROR
}

enum CalendarEventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

enum CalendarEventSource {
  CRM
  GOOGLE
}

enum CalendarAttendeeResponseStatus {
  NEEDS_ACTION
  ACCEPTED
  DECLINED
  TENTATIVE
}

enum CalendarWatchStatus {
  ACTIVE
  EXPIRED
  STOPPED
  ERROR
}

enum CalendarSyncDirection {
  INBOUND
  OUTBOUND
  RECONCILE
  RENEW_WATCH
}

enum CalendarSyncOperation {
  CREATE_EVENT
  UPDATE_EVENT
  DELETE_EVENT
  INCREMENTAL_SYNC
  FULL_SYNC
  RENEW_WATCH
  STOP_WATCH
}

enum CalendarSyncJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

enum IllustrationKind {
  PRELIMINARY
  OFFICIAL
}

enum ApplicationStatus {
  DRAFT
  STARTED
  SUBMITTED
  UNDERWRITING
  APPROVED
  ISSUED
  DECLINED
  WITHDRAWN
}

enum NationalLifeConnectorCommandState {
  QUEUED
  RUNNING
  AUTH_REQUIRED
  WAITING_FOR_CONFIRMATION
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum NationalLifeConnectorConfirmationState {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum RequirementStatus {
  OPEN
  RECEIVED
  WAIVED
}

enum PolicyTransactionType {
  PREMIUM
  CHARGE
  LOAN
  WITHDRAWAL
  ADJUSTMENT
}

enum CommissionTransactionType {
  EXPECTED
  PAID
  CHARGEBACK
  ADJUSTMENT
}

/// A promotion credit is an immutable event, not a mutable balance. Carrier
/// confirmations, corrections and reversals therefore append another event.
enum PromotionCreditStatus {
  ESTIMATED
  PENDING_CARRIER
  CONFIRMED
  ADJUSTED
  REVERSED
}

/// PERSONAL and AGENCY are separate roll-up views of the same production event.
/// Consumers must aggregate one kind at a time so the producer is never counted
/// twice inside an agency total.
enum PromotionCreditAttributionKind {
  PERSONAL
  AGENCY
}

/// Entitlement for the Journey surface. This is an explicit plan capability,
/// never inferred from whether an agent currently has children in the hierarchy.
enum PromotionAccessScope {
  PERSONAL
  AGENCY
}

enum PromotionAchievementRoute {
  PERSONAL
  AGENCY
}

enum SyncStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  NEEDS_REVIEW
}

enum BrowserJobState {
  QUEUED
  RUNNING
  ACTION_REQUIRED
  WAITING_FOR_MFA
  WAITING_FOR_REVIEW
  RETRYABLE
  CREDENTIALS_EXPIRED
  MANUAL_REVIEW
  SUCCEEDED
  FAILED
  CANCELLED
}

enum BrowserJobOperation {
  TEST_CONNECTION
  SYNC_CASE_READ
  GET_RAPID_SOLVE_QUOTE
  GENERATE_ILLUSTRATION_PDF
  SYNC_NATIONAL_LIFE_GRID
  SYNC_FORESIGHT_READ
  GENERATE_FORESIGHT_PDF
}

enum NationalLifeSyncRunState {
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  PARTIAL
  FAILED
}

enum NationalLifeForesightReadRunState {
  QUEUED
  RUNNING
  PAUSED
  PARTIAL
  COMPLETED
  FAILED
}

enum NationalLifeForesightReadMode {
  INVENTORY
  DETAIL
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role
  createdAt DateTime @default(now())
  /// IANA zone used by Agenda, reminders and local wall-clock input. Existing
  /// users retain the product's historical New York behavior after migration.
  timeZone  String   @default("America/New_York")

  agent                Agent?
  client               Client?
  imports              ImportBatch[]
  auditLogs            AuditLog[]
  emailVerified        Boolean               @default(false)
  image                String?
  updatedAt            DateTime              @updatedAt
  sessions             Session[]
  accounts             Account[]
  uploadedDocuments    PolicyDocument[]
  createdFollowUps     FollowUp[]            @relation("FollowUpCreator")
  notifications        Notification[]        @relation("NotificationRecipient")
  calendarIntegrations CalendarIntegration[]
  calendarEvents       CalendarEvent[]       @relation("CalendarEventOwner")
  calendarOAuthStates  CalendarOAuthState[]

  @@map("user")
}

model Agent {
  id                   String               @id @default(cuid())
  userId               String               @unique
  user                 User                 @relation(fields: [userId], references: [id])
  parentAgentId        String?
  parentAgent          Agent?               @relation("AgentHierarchy", fields: [parentAgentId], references: [id])
  subAgents            Agent[]              @relation("AgentHierarchy")
  rank                 String
  npn                  String?              @unique
  status               AgentStatus          @default(ACTIVE)
  promotionAccessScope PromotionAccessScope @default(PERSONAL)
  createdAt            DateTime             @default(now())

  clients                               Client[]
  policies                              Policy[]
  commissionRecords                     CommissionRecord[]
  prospects                             Prospect[]
  insuranceCases                        InsuranceCase[]
  commissionTransactions                CommissionTransaction[]
  integrationCredentials                AgentIntegrationCredential[]
  integrationSessions                   AgentIntegrationSession[]
  nationalLifeConnectionAttempts        NationalLifeConnectionAttempt[]
  browserJobs                           BrowserAutomationJob[]
  nationalLifeSyncRuns                  NationalLifeSyncRun[]
  nationalLifeCaseSnapshots             NationalLifeCaseSnapshot[]
  nationalLifeForesightReadRuns         NationalLifeForesightReadRun[]
  nationalLifeForesightCaseSnapshots    NationalLifeForesightCaseSnapshot[]
  nationalLifeForesightServiceSnapshots NationalLifeForesightServiceSnapshot[]
  nationalLifeForesightDocuments        NationalLifeForesightDocument[]
  illustrations                         Illustration[]
  nationalLifeInforcePolicies           NationalLifeInforcePolicy[]
  nationalLifePolicyDetailSnapshots     NationalLifePolicyDetailSnapshot[]
  nationalLifeReportRows                NationalLifeReportRow[]
  nationalLifeRawGridPages              NationalLifeRawGridPage[]
  nationalLifeConnectorPairings         NationalLifeConnectorPairing[]
  nationalLifeConnectorDevices          NationalLifeConnectorDevice[]
  nationalLifeConnectorCommands         NationalLifeConnectorCommand[]
  nationalLifeExportUploads             NationalLifeExportUpload[]
  nationalLifeDocumentTransfers         NationalLifeDocumentTransfer[]
  messagingAccount                      AgentMessagingAccount?
  messagingChannels                     AgentMessagingChannel[]
  producedPromotionCredits              PromotionCredit[]                      @relation("PromotionCreditProducer")
  promotionCreditAttributions           PromotionCreditAttribution[]           @relation("PromotionCreditAttributedAgent")
  ledPromotionCreditAttributions        PromotionCreditAttribution[]           @relation("PromotionCreditAttributionLeader")
  promotionAchievements                 PromotionAchievement[]
  crmPipeline                           CrmPipeline?
  ownedFollowUps                        FollowUp[]                             @relation("FollowUpOwner")

  @@index([parentAgentId])
}

/// Raw landing zone for rows read from the National Life agent portal grids.
/// Deliberately not mapped into Prospect/InsuranceCase/Application yet: that
/// mapping is a separate decision, and Policy still holds synthetic seed rows.
/// `raw` keeps the untouched carrier payload so no field is lost to normalisation.
model NationalLifeCaseSnapshot {
  id                       String   @id @default(cuid())
  agentId                  String
  agent                    Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deploymentScope          String
  gridKey                  String
  policyNo                 String
  insuredName              String?
  ownerName                String?
  product                  String?
  carrierStatus            String?
  deliveryStatus           String?
  actionRequired           String?
  requirements             String?
  submitDate               String?
  sentDate                 String?
  modalPremium             String?
  anticipatedAnnualPremium String?
  /// Carrier Target Premium / CTP as reported. Kept distinct from AAP above;
  /// neither value is derived from commission dollars.
  targetPremium            String?
  submitMethod             String?
  caseManager              String?
  agency                   String?
  writingAgentName         String?
  writingAgentNumber       String?
  companyCode              String?
  raw                      Json
  fetchedAt                DateTime
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([agentId, deploymentScope, gridKey, policyNo])
  @@index([agentId, gridKey])
  @@index([fetchedAt])
}

/// Raw landing zone for the inforce book grid. Distinct from
/// NationalLifeCaseSnapshot: this is policy/client demographic data (owner and
/// insured name, DOB, address, contact, cash value), not a submission-pipeline
/// case, and the carrier's own field names differ (PolicyNumber, not PolicyNo).
/// Contains real client PII, stored in plaintext to match how Client already
/// stores name/email/phone in this schema — same trust boundary, no new gap.
model NationalLifeInforcePolicy {
  id                       String   @id @default(cuid())
  agentId                  String
  agent                    Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deploymentScope          String
  policyNumber             String
  nbPolicyNumber           String?
  policyStatus             String?
  policyIssueDate          String?
  lastStatusChangeDate     String?
  productClass             String?
  productName              String?
  productCode              String?
  companyCode              String?
  systemCode               String?
  planCode                 String?
  agentNumber              String?
  agentName                String?
  servicingAgentName       String?
  servicingAgencyName      String?
  insuredClientName        String?
  insuredDob               String?
  insuredEmail             String?
  insuredPhoneNumber       String?
  ownerClientName          String?
  ownerDob                 String?
  ownerEmail               String?
  ownerPhoneNumber         String?
  insuredAddress           String?
  insuredAddressLine1      String?
  insuredAddressLine2      String?
  insuredCity              String?
  insuredState             String?
  insuredZipcode           String?
  ownerAddress             String?
  ownerAddressLine1        String?
  ownerAddressLine2        String?
  ownerCity                String?
  ownerState               String?
  ownerZipcode             String?
  accumulatedCashValue     String?
  anticipatedAnnualPremium String?
  /// Carrier Target Premium / CTP as reported. Optional because the in-force
  /// grid may omit it; `raw` remains the source trace.
  targetPremium            String?
  termConversionDate       String?
  levelPeriodEndDate       String?
  employerName             String?
  raw                      Json
  fetchedAt                DateTime
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([agentId, deploymentScope, policyNumber])
  @@index([agentId])
  @@index([fetchedAt])
}

/// Latest normalized coverage/payment detail read from the carrier's
/// per-policy page. This is intentionally typed and bounded: the connector does
/// not persist a DOM dump containing unrelated client information.
model NationalLifePolicyDetailSnapshot {
  id                           String    @id @default(cuid())
  agentId                      String
  agent                        Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deploymentScope              String
  policyId                     String    @unique
  policy                       Policy    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  policyNumber                 String
  sourcePath                   String
  coverageCaptured             Boolean   @default(false)
  paymentsCaptured             Boolean   @default(false)
  totalFaceAmount              Decimal?  @db.Decimal(18, 2)
  netDeathBenefit              Decimal?  @db.Decimal(18, 2)
  nextScheduledPaymentDate     DateTime?
  paymentFrequency             String?
  plannedPeriodicPayment       Decimal?  @db.Decimal(18, 2)
  anticipatedAnnualPremium     Decimal?  @db.Decimal(18, 2)
  minimumMonthlyPremium        Decimal?  @db.Decimal(18, 2)
  minimumGuaranteedPremium     Decimal?  @db.Decimal(18, 2)
  ctp                          Decimal?  @db.Decimal(18, 2)
  mecLimit                     Decimal?  @db.Decimal(18, 2)
  mecLimitThrough              DateTime?
  guidelinePremiumLimit        Decimal?  @db.Decimal(18, 2)
  guidelinePremiumLimitThrough DateTime?
  observedAt                   DateTime
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  @@index([agentId, deploymentScope, observedAt])
  @@index([policyNumber])
}

/// Generic landing zone for the portal's report grids — paid commissions,
/// projected commissions, and whatever else is mapped later.
///
/// One table rather than one per report: these are statement-level summaries (8
/// and 4 rows respectively, not transaction ledgers) whose columns differ
/// completely from each other, so typed columns per report would be mostly nulls.
/// `raw` holds the carrier row verbatim and `amounts` the numeric fields pulled
/// out of it, which is what a front end needs without a migration per report.
model NationalLifeReportRow {
  id                String                         @id @default(cuid())
  agentId           String
  agent             Agent                          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deploymentScope   String
  gridKey           String
  /// Deterministic per-report identity, so a re-sync updates instead of duplicating.
  rowKey            String
  primaryDate       String?
  label             String?
  amounts           Json
  raw               Json
  fetchedAt         DateTime
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  policyDocuments   PolicyDocument[]
  documentTransfers NationalLifeDocumentTransfer[]

  @@unique([agentId, deploymentScope, gridKey, rowKey])
  @@index([agentId, gridKey])
  @@index([fetchedAt])
}

/// Faithful, page-by-page landing zone for the latest verified carrier grid.
///
/// The normalized models above intentionally collapse duplicate policies and
/// reject rows without a usable business key. This model does neither: every
/// record delivered by the National Life grid is retained in its original
/// order and shape. Pages from an older successful snapshot are removed only
/// after the replacement stage has reconciled against `recordsTotal`.
model NationalLifeRawGridPage {
  id              String              @id @default(cuid())
  agentId         String
  agent           Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deploymentScope String
  runId           String
  run             NationalLifeSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  gridKey         String
  sequence        Int
  recordCount     Int
  contentHash     String
  records         Json
  observedAt      DateTime
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([runId, gridKey, sequence])
  @@index([agentId, deploymentScope, gridKey])
  @@index([runId, gridKey])
}

model NationalLifeForesightReadRun {
  id                String                            @id @default(cuid())
  agentId           String
  agent             Agent                             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deploymentScope   String                            @default("SINGLE_DEPLOYMENT")
  provider          String                            @default("NATIONAL_LIFE")
  mode              NationalLifeForesightReadMode
  state             NationalLifeForesightReadRunState @default(QUEUED)
  targetCaseId      String?
  totalCases        Int                               @default(0)
  inventoriedCases  Int                               @default(0)
  totalServices     Int                               @default(0)
  completedServices Int                               @default(0)
  currentCaseName   String?
  currentService    String?
  safeErrorCode     String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime                          @default(now())
  updatedAt         DateTime                          @updatedAt
  jobs              BrowserAutomationJob[]

  @@index([agentId, deploymentScope, state, createdAt])
}

model NationalLifeForesightCaseSnapshot {
  id              String                                 @id @default(cuid())
  agentId         String
  agent           Agent                                  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deploymentScope String
  provider        String                                 @default("NATIONAL_LIFE")
  externalKey     String
  displayName     String
  caseKind        String?
  product         String?
  status          String?
  state           String?
  observedAt      DateTime
  raw             Json
  createdAt       DateTime                               @default(now())
  updatedAt       DateTime                               @updatedAt
  services        NationalLifeForesightServiceSnapshot[]
  documents       NationalLifeForesightDocument[]

  @@unique([agentId, deploymentScope, provider, externalKey])
  @@unique([id, agentId, deploymentScope, provider])
  @@index([agentId, deploymentScope, observedAt])
}

model NationalLifeForesightServiceSnapshot {
  id              String                            @id @default(cuid())
  caseSnapshotId  String
  agentId         String
  agent           Agent                             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deploymentScope String
  provider        String                            @default("NATIONAL_LIFE")
  caseSnapshot    NationalLifeForesightCaseSnapshot @relation(fields: [caseSnapshotId, agentId, deploymentScope, provider], references: [id, agentId, deploymentScope, provider], onDelete: Cascade)
  serviceName     String
  payloadShape    Json
  payload         Json
  validationState String
  observedAt      DateTime
  createdAt       DateTime                          @default(now())
  updatedAt       DateTime                          @updatedAt

  @@unique([caseSnapshotId, serviceName])
  @@index([caseSnapshotId, observedAt])
  @@index([agentId, deploymentScope, provider, observedAt])
}

model NationalLifeForesightDocument {
  id              String                            @id @default(cuid())
  caseSnapshotId  String
  agentId         String
  agent           Agent                             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deploymentScope String
  provider        String                            @default("NATIONAL_LIFE")
  caseSnapshot    NationalLifeForesightCaseSnapshot @relation(fields: [caseSnapshotId, agentId, deploymentScope, provider], references: [id, agentId, deploymentScope, provider], onDelete: Cascade)
  reportKey       String
  filename        String
  mimeType        String
  byteSize        Int
  contentHash     String
  /// Caminho do PDF dentro de `UPLOADS_DIR`. Nulo em linhas escritas antes desta
  /// coluna — o backfill (`scripts/national-life-backfill-foresight-documents.ts`)
  /// é quem as move.
  storageKey      String?
  /// O PDF em si, quando ainda está no banco. Escritas novas nascem com `bytes`
  /// nulo e `storageKey` preenchido; a coluna sobrevive para não perder o que já
  /// foi gravado. Derrubá-la é uma migração separada, depois do backfill
  /// verificado em produção — dropar dado e mudar caminho de escrita no mesmo
  /// deploy não deixa para onde voltar.
  bytes           Bytes?
  renderState     String
  safeErrorCode   String?
  fetchedAt       DateTime?
  createdAt       DateTime                          @default(now())
  updatedAt       DateTime                          @updatedAt

  @@unique([caseSnapshotId, reportKey])
  @@index([caseSnapshotId, createdAt])
  @@index([agentId, deploymentScope, provider, createdAt])
}

model Client {
  id              String    @id @default(cuid())
  userId          String?   @unique
  user            User?     @relation(fields: [userId], references: [id])
  name            String
  email           String?
  phone           String?
  // The carrier reports it on every inforce policy, for 98% of the book. Stored
  // as a date rather than the carrier's MM/DD/YYYY string so age and birthdays
  // are computable instead of needing to be re-parsed at every call site.
  dateOfBirth     DateTime?
  assignedAgentId String
  assignedAgent   Agent     @relation(fields: [assignedAgentId], references: [id])
  createdAt       DateTime  @default(now())

  policies       Policy[]
  insuranceCases InsuranceCase[]
  illustrations  Illustration[]

  @@index([assignedAgentId])
}

model Policy {
  id                     String                            @id @default(cuid())
  clientId               String
  client                 Client                            @relation(fields: [clientId], references: [id])
  agentId                String
  agent                  Agent                             @relation(fields: [agentId], references: [id])
  carrier                String
  product                String
  policyNumber           String                            @unique
  // Null means "not known yet", not zero. The bulk export omits face amount;
  // the carrier policy-detail page supplies it on demand.
  faceAmount             Decimal?
  faceAmountSource       String?
  // The carrier's own status string, kept beside the mapped enum. PolicyStatus
  // has no "Pending Lapse", and that is precisely the status worth acting on,
  // so mapping it to INFORCE alone would erase the signal.
  sourceStatus           String?
  // The modal premium — what the client actually pays each time — kept with the
  // mode it is paid in. Annualising on write would destroy the distinction the
  // client chose: $250 monthly and $250 annual are different policies.
  // Null means the carrier has not supplied a premium in a structured source.
  // It must not be rendered or aggregated as zero.
  premium                Decimal?
  premiumMode            String?
  carrierDetailUpdatedAt DateTime?
  status                 PolicyStatus
  effectiveDate          DateTime?
  lastPaymentDate        DateTime?
  statusChangedAt        DateTime?
  importBatchId          String?
  importBatch            ImportBatch?                      @relation(fields: [importBatchId], references: [id])
  caseId                 String?
  case                   InsuranceCase?                    @relation(fields: [caseId], references: [id])
  sourceProvider         String?
  sourceExternalId       String?
  sourceUpdatedAt        DateTime?
  nationalLifeDetail     NationalLifePolicyDetailSnapshot?
  createdAt              DateTime                          @default(now())

  commissionRecords             CommissionRecord[]
  documents                     PolicyDocument[]
  nationalLifeDocumentTransfers NationalLifeDocumentTransfer[]
  snapshots                     PolicySnapshot[]
  transactions                  PolicyTransaction[]
  commissionTransactions        CommissionTransaction[]
  reviews                       PolicyReview[]

  @@unique([sourceProvider, sourceExternalId])
  @@index([agentId])
  @@index([clientId])
  @@index([caseId])
}

model Prospect {
  id              String          @id @default(cuid())
  firstName       String
  lastName        String
  email           String?
  phone           String?
  dateOfBirth     DateTime?
  state           String?
  tobaccoStatus   String?
  assignedAgentId String
  assignedAgent   Agent           @relation(fields: [assignedAgentId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  cases           InsuranceCase[]

  @@index([assignedAgentId])
}

model InsuranceCase {
  id              String                 @id @default(cuid())
  prospectId      String
  prospect        Prospect               @relation(fields: [prospectId], references: [id])
  assignedAgentId String
  assignedAgent   Agent                  @relation(fields: [assignedAgentId], references: [id])
  clientId        String?
  client          Client?                @relation(fields: [clientId], references: [id])
  stage           CaseStage              @default(LEAD)
  /// Dynamic CRM stage. Nullable during rolling deploys; the CRM migration
  /// backfills every existing case and services always assign it for new work.
  crmStageId      String?
  crmStage        CrmStage?              @relation(fields: [crmStageId], references: [id])
  status          CaseStatus             @default(OPEN)
  objective       String?
  targetCoverage  Decimal?
  monthlyBudget   Decimal?
  needsAnalysis   Json?
  carrier         String?
  productType     String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  illustrations   Illustration[]
  applications    Application[]
  timelineEvents  CaseTimelineEvent[]
  policies        Policy[]
  browserJobs     BrowserAutomationJob[]
  followUps       FollowUp[]
  notifications   Notification[]
  calendarEvents  CalendarEvent[]

  @@index([assignedAgentId, stage])
  @@index([assignedAgentId, crmStageId])
  @@index([prospectId])
  @@index([clientId])
}

/// One Chatwoot account per agent, never a shared account with per-inbox rules:
/// agents are independent and a configuration slip would show one agent's book to
/// a competitor. Isolation is structural here, not procedural.
model AgentMessagingAccount {
  id                String   @id @default(cuid())
  agentId           String   @unique
  agent             Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  provider          String   @default("CHATWOOT")
  externalAccountId String
  externalUserId    String
  externalUserToken String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, externalAccountId])
}

/// An agent can own one identity of each channel kind (WhatsApp, email, etc.).
/// Provider identifiers, addresses and inboxes remain globally unique so a
/// reconnect can never move another agent's conversations by accident.
model AgentMessagingChannel {
  id                    String                   @id @default(cuid())
  agentId               String
  agent                 Agent                    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  kind                  MessagingChannelKind
  provider              MessagingChannelProvider
  status                MessagingChannelStatus   @default(PROVISIONING)
  normalizedPhoneE164   String?                  @unique
  externalPhoneNumberId String?                  @unique
  externalWabaId        String?
  externalInboxId       String?                  @unique
  evolutionInstanceName String?                  @unique
  verifiedAt            DateTime?                @db.Timestamptz(3)
  lastInboundAt         DateTime?                @db.Timestamptz(3)
  lastOutboundAt        DateTime?                @db.Timestamptz(3)
  lastHealthCheckAt     DateTime?                @db.Timestamptz(3)
  lastErrorCode         String?
  createdAt             DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @db.Timestamptz(3)

  @@unique([agentId, kind])
  @@index([provider, status])
}

/// One independently configurable CRM pipeline per agent account. "Todos" is
/// intentionally not stored here: it is a virtual filter in the CRM query.
model CrmPipeline {
  id        String     @id @default(cuid())
  agentId   String     @unique
  agent     Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  stages    CrmStage[]
}

model CrmStage {
  id         String          @id @default(cuid())
  pipelineId String
  pipeline   CrmPipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name       String
  position   Int
  /// Stable meaning for product-owned stages (for example FOLLOW_UP). Custom
  /// stages leave this null and remain fully renameable/reorderable.
  systemKey  String?
  active     Boolean         @default(true)
  archivedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  cases      InsuranceCase[]

  @@unique([pipelineId, systemKey])
  @@index([pipelineId, active, position])
}

model FollowUp {
  id                    String             @id @default(cuid())
  caseId                String
  insuranceCase         InsuranceCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  ownerAgentId          String
  ownerAgent            Agent              @relation("FollowUpOwner", fields: [ownerAgentId], references: [id], onDelete: Cascade)
  createdByUserId       String
  createdByUser         User               @relation("FollowUpCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  title                 String             @default("Follow-up")
  scheduledAt           DateTime           @db.Timestamptz(3)
  status                FollowUpStatus     @default(SCHEDULED)
  completedAt           DateTime?          @db.Timestamptz(3)
  cancelledAt           DateTime?          @db.Timestamptz(3)
  sourceTimelineEventId String?            @unique
  sourceTimelineEvent   CaseTimelineEvent? @relation(fields: [sourceTimelineEventId], references: [id], onDelete: SetNull)
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3)
  notifications         Notification[]
  // Partial unique (one SCHEDULED row per case) lives in SQL migration because
  // Prisma schema syntax cannot represent a PostgreSQL WHERE predicate.

  @@index([ownerAgentId, status, scheduledAt])
  @@index([caseId, status, scheduledAt])
  @@index([status, scheduledAt])
}

model Notification {
  id              String         @id @default(cuid())
  recipientUserId String
  recipient       User           @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  followUpId      String?
  followUp        FollowUp?      @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  caseId          String?
  insuranceCase   InsuranceCase? @relation(fields: [caseId], references: [id], onDelete: Cascade)
  calendarEventId String?
  calendarEvent   CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  type            String
  title           String
  message         String
  href            String
  dedupeKey       String         @unique
  readAt          DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)

  @@index([recipientUserId, readAt, createdAt])
  @@index([followUpId])
  @@index([caseId])
  @@index([calendarEventId])
}

/// One Google account connection owned by exactly one authenticated user. It is
/// intentionally independent from Better Auth's Account table: Calendar OAuth
/// grants are product integrations and their tokens are encrypted at rest.
model CalendarIntegration {
  id                String                    @id @default(cuid())
  userId            String
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          CalendarProvider          @default(GOOGLE)
  providerAccountId String
  providerEmail     String
  displayName       String?
  status            CalendarIntegrationStatus @default(CONNECTED)
  grantedScopes     String[]                  @default([])

  accessKeyVersion  String?
  accessAlgorithm   String?
  accessIv          String?
  accessCiphertext  String?
  accessAuthTag     String?
  refreshKeyVersion String?
  refreshAlgorithm  String?
  refreshIv         String?
  refreshCiphertext String?
  refreshAuthTag    String?
  tokenExpiresAt    DateTime? @db.Timestamptz(3)

  connectedAt    DateTime  @default(now()) @db.Timestamptz(3)
  lastSyncAt     DateTime? @db.Timestamptz(3)
  lastErrorCode  String?
  disconnectedAt DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  calendars     CalendarSource[]
  events        CalendarEvent[]
  watchChannels CalendarWatchChannel[]
  syncJobs      CalendarSyncJob[]

  @@unique([userId, provider])
  @@index([userId, status])
  @@index([provider, status])
}

/// A calendar returned by Google CalendarList. Visibility and CRM default are
/// user preferences; syncToken belongs to this exact event collection.
model CalendarSource {
  id                    String              @id @default(cuid())
  integrationId         String
  integration           CalendarIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  providerCalendarId    String
  name                  String
  description           String?
  colorId               String?
  backgroundColor       String?
  foregroundColor       String?
  isPrimary             Boolean             @default(false)
  visible               Boolean             @default(true)
  crmDefault            Boolean             @default(false)
  accessRole            String?
  timeZone              String?
  syncToken             String?
  syncStatus            CalendarSyncStatus  @default(PENDING)
  lastIncrementalSyncAt DateTime?           @db.Timestamptz(3)
  lastFullSyncAt        DateTime?           @db.Timestamptz(3)
  lastErrorCode         String?
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(3)

  events        CalendarEvent[]
  watchChannels CalendarWatchChannel[]
  syncJobs      CalendarSyncJob[]

  @@unique([integrationId, providerCalendarId])
  @@index([integrationId, visible])
  @@index([integrationId, crmDefault])
}

/// Local projection of one provider event. External events remain owned by the
/// connected user and are never promoted into CRM activity without an explicit
/// insuranceCaseId association.
model CalendarEvent {
  id              String              @id @default(cuid())
  ownerUserId     String
  ownerUser       User                @relation("CalendarEventOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  integrationId   String
  integration     CalendarIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  calendarId      String
  calendar        CalendarSource      @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  insuranceCaseId String?
  insuranceCase   InsuranceCase?      @relation(fields: [insuranceCaseId], references: [id], onDelete: SetNull)

  providerEventId           String?
  providerRecurringEventId  String?
  providerOriginalStartAt   DateTime? @db.Timestamptz(3)
  providerOriginalStartDate DateTime? @db.Date
  recurrence                String[]  @default([])
  iCalUid                   String?
  etag                      String?
  sequence                  Int?

  title          String
  description    String?
  startsAt       DateTime? @db.Timestamptz(3)
  endsAt         DateTime? @db.Timestamptz(3)
  startDate      DateTime? @db.Date
  endDate        DateTime? @db.Date
  timeZone       String?
  allDay         Boolean   @default(false)
  location       String?
  meetingUrl     String?
  conferenceData Json?
  reminders      Json?
  colorId        String?
  visibility     String?
  transparency   String?

  status            CalendarEventStatus @default(CONFIRMED)
  source            CalendarEventSource @default(GOOGLE)
  syncStatus        CalendarSyncStatus  @default(PENDING)
  syncErrorCode     String?
  providerUpdatedAt DateTime?           @db.Timestamptz(3)
  deletedAt         DateTime?           @db.Timestamptz(3)
  lastSyncedAt      DateTime?           @db.Timestamptz(3)
  localRevision     Int                 @default(1)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)

  attendees     CalendarEventAttendee[]
  syncJobs      CalendarSyncJob[]
  notifications Notification[]

  @@unique([calendarId, providerEventId])
  @@index([ownerUserId, startsAt, status])
  @@index([ownerUserId, startDate, status])
  @@index([insuranceCaseId, startsAt])
  @@index([integrationId, syncStatus])
  @@index([providerRecurringEventId, providerOriginalStartAt])
}

model CalendarEventAttendee {
  id             String                         @id @default(cuid())
  eventId        String
  event          CalendarEvent                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  email          String
  name           String?
  responseStatus CalendarAttendeeResponseStatus @default(NEEDS_ACTION)
  isSelf         Boolean                        @default(false)
  isOrganizer    Boolean                        @default(false)
  createdAt      DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                       @updatedAt @db.Timestamptz(3)

  @@unique([eventId, email])
  @@index([email])
}

/// Google push notifications contain no event body. A channel only identifies
/// which CalendarSource needs an incremental sync.
model CalendarWatchChannel {
  id                String              @id @default(cuid())
  integrationId     String
  integration       CalendarIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  calendarId        String
  calendar          CalendarSource      @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  providerChannelId String              @unique
  resourceId        String
  resourceUri       String?
  channelTokenHash  String
  expiresAt         DateTime            @db.Timestamptz(3)
  lastMessageNumber BigInt?
  status            CalendarWatchStatus @default(ACTIVE)
  lastReceivedAt    DateTime?           @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)

  @@index([calendarId, status, expiresAt])
  @@index([integrationId, status])
}

/// Durable outbox and background work queue. Local event mutations enqueue a
/// job in the same transaction; workers lease rows with SKIP LOCKED.
model CalendarSyncJob {
  id              String                @id @default(cuid())
  integrationId   String
  integration     CalendarIntegration   @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  calendarId      String?
  calendar        CalendarSource?       @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  eventId         String?
  event           CalendarEvent?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  direction       CalendarSyncDirection
  operation       CalendarSyncOperation
  status          CalendarSyncJobStatus @default(PENDING)
  desiredRevision Int?
  sendInvites     Boolean               @default(false)
  payload         Json?
  attempts        Int                   @default(0)
  availableAt     DateTime              @default(now()) @db.Timestamptz(3)
  leaseOwner      String?
  leaseExpiresAt  DateTime?             @db.Timestamptz(3)
  idempotencyKey  String                @unique
  lastErrorCode   String?
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)

  @@index([status, availableAt])
  @@index([integrationId, status])
  @@index([calendarId, status])
  @@index([eventId, status])
  @@index([leaseExpiresAt])
}

/// One-use, short-lived OAuth transaction. The raw state and PKCE verifier are
/// never persisted in plaintext; callbacks consume this row atomically.
model CalendarOAuthState {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider           CalendarProvider @default(GOOGLE)
  stateHash          String           @unique
  sessionTokenHash   String
  verifierKeyVersion String
  verifierAlgorithm  String
  verifierIv         String
  verifierCiphertext String
  verifierAuthTag    String
  returnTo           String?
  expiresAt          DateTime         @db.Timestamptz(3)
  consumedAt         DateTime?        @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)

  @@index([userId, expiresAt])
  @@index([expiresAt, consumedAt])
}

model AgentIntegrationCredential {
  id              String    @id @default(cuid())
  agentId         String
  agent           Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  provider        String
  maskedUsername  String
  keyVersion      String
  algorithm       String
  iv              String
  ciphertext      String
  authTag         String
  status          String    @default("UNTESTED")
  lastTestedAt    DateTime?
  lastSucceededAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([agentId, provider])
  @@index([provider, status])
}

model AgentIntegrationSession {
  id                       String    @id @default(cuid())
  agentId                  String
  agent                    Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deploymentScope          String    @default("SINGLE_DEPLOYMENT")
  provider                 String
  purpose                  String    @default("CARRIER_SESSION")
  status                   String    @default("CONNECTED")
  formatVersion            Int       @default(1)
  keyVersion               String?
  algorithm                String?
  iv                       String?
  ciphertext               String?
  authTag                  String?
  // Derived from the shortest cookie expiry, which measured on 2026-07-31 is
  // Cloudflare's 30-minute bot cookie — the portal answered authenticated three
  // minutes past it. Kept because the probe output references it, but it is not
  // a session deadline and is no longer shown as one.
  carrierExpiresAt         DateTime?
  lastConnectedAt          DateTime
  lastUsedAt               DateTime?
  // The illustration path (Foresight) sits behind the carrier's Auth0 tenant,
  // whose session dies while the portal session lives. Written by the outcome of
  // the two jobs that actually cross the SSO jump (SYNC_FORESIGHT_READ and
  // GENERATE_FORESIGHT_PDF), not by the keep-alive tick — which is off in
  // production, and is why this field used to go stale. The agent learns the PDF
  // is out of reach before clicking towards it. Last crossing only — nothing
  // here predicts the next one.
  illustrationSsoReachable Boolean?
  illustrationSsoCheckedAt DateTime?
  /// The browser the human actually logged in on, kept alive instead of thrown
  /// away.
  ///
  /// The illustration tool's token lives in the page's memory — `auth0-spa-js`
  /// defaults to `cacheLocation: memory`, and the stored context confirms it:
  /// the identity provider's `localStorage` holds only orphaned `/authorize`
  /// transactions, never a cached token. So a browser rebuilt from cookies
  /// wakes up without one and has to cross the identity provider again, which
  /// is what has been burning the session. The browser that logged in is the
  /// one that has the token, so jobs reattach to it.
  ///
  /// Stored in the clear on purpose: Steel has no public route and lives on a
  /// private Docker network, so the handle is useless without access there —
  /// and anyone who has that already has the running browser. Encrypting it
  /// beside a cookie jar that grants the same access would be ceremony.
  ///
  /// Null is the ordinary state, not an error: it means no live browser is
  /// held and every job builds its own from the stored context, exactly as
  /// before this column existed.
  liveSteelSessionId       String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@unique([agentId, deploymentScope, provider, purpose])
  @@index([provider, status])
}

model NationalLifeConnectionAttempt {
  id                     String    @id @default(cuid())
  agentId                String
  agent                  Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deploymentScope        String    @default("SINGLE_DEPLOYMENT")
  provider               String
  purpose                String    @default("INTERACTIVE_CONNECTION_ATTEMPT")
  state                  String
  formatVersion          Int       @default(1)
  runtimeKeyVersion      String?
  runtimeAlgorithm       String?
  runtimeIv              String?
  runtimeCiphertext      String?
  runtimeAuthTag         String?
  viewerNonceHash        String?
  currentOrigin          String?
  safeErrorCode          String?
  nextPollAt             DateTime?
  reconnectAttemptCount  Int       @default(0)
  browserProvider        String?
  browserShardId         String?
  lastTransportFailureAt DateTime?
  leaseOwner             String?
  leaseExpiresAt         DateTime?
  expiresAt              DateTime
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([agentId, deploymentScope, provider, purpose])
  @@index([state, expiresAt])
  @@index([leaseExpiresAt])
  @@index([state, nextPollAt])
}

model BrowserAutomationJob {
  id                     String                        @id @default(cuid())
  agentId                String
  agent                  Agent                         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deploymentScope        String?
  caseId                 String?
  insuranceCase          InsuranceCase?                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  provider               String
  operation              BrowserJobOperation
  syncRunId              String?
  syncRun                NationalLifeSyncRun?          @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  foresightRunId         String?
  foresightRun           NationalLifeForesightReadRun? @relation(fields: [foresightRunId], references: [id], onDelete: Cascade)
  syncStageIndex         Int?
  syncGridKey            String?
  state                  BrowserJobState               @default(QUEUED)
  idempotencyKey         String                        @unique
  input                  Json
  result                 Json?
  safeErrorCode          String?
  safeErrorDetail        Json?
  attemptCount           Int                           @default(0)
  availableAt            DateTime                      @default(now())
  leaseOwner             String?
  leaseExpiresAt         DateTime?
  continuationKeyVersion String?
  continuationIv         String?
  continuationCiphertext String?
  continuationAuthTag    String?
  continuationExpiresAt  DateTime?
  startedAt              DateTime?
  finishedAt             DateTime?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt

  @@index([state, availableAt])
  @@index([agentId, createdAt])
  @@index([agentId, deploymentScope, provider])
  @@index([caseId, createdAt])
  @@index([syncRunId, syncStageIndex, state])
}

model NationalLifeSyncRun {
  id                String                                 @id @default(cuid())
  agentId           String
  agent             Agent                                  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  connectorDeviceId String?
  connectorDevice   NationalLifeConnectorDevice?           @relation(fields: [connectorDeviceId], references: [id], onDelete: SetNull)
  deploymentScope   String                                 @default("SINGLE_DEPLOYMENT")
  provider          String                                 @default("NATIONAL_LIFE")
  executionSource   String                                 @default("REMOTE")
  state             NationalLifeSyncRunState               @default(QUEUED)
  totalStages       Int
  completedStages   Int                                    @default(0)
  failedStages      Int                                    @default(0)
  currentGridKey    String?
  /// As grades que este run planejou ler. Vazio significa "o par padrão legado"
  /// (NEW_BUSINESS, INFORCE_CLIENTS): runs criados antes desta coluna só podiam
  /// ter planejado essas duas, então nenhum backfill é necessário. É a autoridade
  /// do servidor sobre quais estágios pertencem a este run — sem ela o dispositivo
  /// decidiria o que conta como completo.
  plannedGridKeys   String[]                               @default([])
  safeErrorCode     String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime                               @default(now())
  updatedAt         DateTime                               @updatedAt
  jobs              BrowserAutomationJob[]
  stageReceipts     NationalLifeConnectorStageReceipt[]
  stageCompletions  NationalLifeConnectorStageCompletion[]
  stageFailures     NationalLifeConnectorStageFailure[]
  rawGridPages      NationalLifeRawGridPage[]
  exportUploads     NationalLifeExportUpload[]

  @@index([agentId, deploymentScope, state, createdAt])
  @@index([connectorDeviceId, createdAt])
  /// Serve a varredura de recibos de estágio, que seleciona por run terminal
  /// parado há mais de 30 dias. O índice de cima não serve: ele começa por
  /// `agentId`, e a varredura não filtra por agente nenhum — é a tabela inteira.
  @@index([state, updatedAt])
}

model NationalLifeConnectorPairing {
  id         String    @id @default(cuid())
  codeHash   String    @unique
  agentId    String
  agent      Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([agentId, expiresAt])
  /// Dois índices de uma coluna, e não um composto: a varredura procura
  /// `expiresAt < corte` **ou** `consumedAt < corte`, e o Postgres resolve isso
  /// com um BitmapOr dos dois. Um composto `(expiresAt, consumedAt)` só serviria
  /// ao primeiro ramo. O `@@index([agentId, expiresAt])` acima não serve a
  /// nenhum: começa por `agentId`, que a varredura não filtra.
  @@index([expiresAt])
  @@index([consumedAt])
}

model NationalLifeConnectorDevice {
  id                  String                                 @id @default(cuid())
  agentId             String
  agent               Agent                                  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  label               String
  publicKeyJwk        Json
  publicKeyThumbprint String                                 @unique
  status              String                                 @default("ACTIVE")
  lastSeenAt          DateTime?
  revokedAt           DateTime?
  createdAt           DateTime                               @default(now())
  updatedAt           DateTime                               @updatedAt
  replays             NationalLifeConnectorReplay[]
  stageReceipts       NationalLifeConnectorStageReceipt[]
  stageCompletions    NationalLifeConnectorStageCompletion[]
  stageFailures       NationalLifeConnectorStageFailure[]
  syncRuns            NationalLifeSyncRun[]
  commands            NationalLifeConnectorCommand[]
  exportUploads       NationalLifeExportUpload[]
  documentTransfers   NationalLifeDocumentTransfer[]

  @@index([agentId, status])
}

/// Durable command ledger for both local Chrome and remote-browser execution.
/// The payload is only the declared command parameters; carrier responses are
/// stored as events and must remain redacted by the command-specific executor.
model NationalLifeConnectorCommand {
  id                   String                                    @id @default(cuid())
  agentId              String
  agent                Agent                                     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deviceId             String?
  device               NationalLifeConnectorDevice?              @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  protocolVersion      Int
  runId                String
  capability           String
  state                NationalLifeConnectorCommandState         @default(QUEUED)
  target               Json?
  params               Json
  payloadHash          String
  idempotencyKey       String
  requiresConfirmation Boolean                                   @default(false)
  confirmationState    NationalLifeConnectorConfirmationState    @default(NOT_REQUIRED)
  safeErrorCode        String?
  expiresAt            DateTime
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime                                  @default(now())
  updatedAt            DateTime                                  @updatedAt
  events               NationalLifeConnectorCommandEvent[]
  confirmation         NationalLifeConnectorCommandConfirmation?

  @@unique([agentId, idempotencyKey])
  @@index([agentId, state, createdAt])
  @@index([deviceId, state, createdAt])
  @@index([expiresAt])
}

model NationalLifeConnectorCommandEvent {
  id            String                       @id @default(cuid())
  commandId     String
  command       NationalLifeConnectorCommand @relation(fields: [commandId], references: [id], onDelete: Cascade)
  sequence      Int
  type          String
  payload       Json?
  safeErrorCode String?
  createdAt     DateTime                     @default(now())

  @@unique([commandId, sequence])
  @@index([commandId, createdAt])
}

model NationalLifeConnectorCommandConfirmation {
  id                String                                 @id @default(cuid())
  commandId         String                                 @unique
  command           NationalLifeConnectorCommand           @relation(fields: [commandId], references: [id], onDelete: Cascade)
  payloadHash       String
  state             NationalLifeConnectorConfirmationState @default(PENDING)
  confirmedByUserId String?
  confirmedAt       DateTime?
  rejectedAt        DateTime?
  expiresAt         DateTime
  createdAt         DateTime                               @default(now())
  updatedAt         DateTime                               @updatedAt

  @@index([state, expiresAt])
}

model NationalLifeConnectorReplay {
  id        String                      @id @default(cuid())
  deviceId  String
  device    NationalLifeConnectorDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  jti       String
  expiresAt DateTime
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt

  @@unique([deviceId, jti])
  @@index([expiresAt])
}

model NationalLifeConnectorStageReceipt {
  id             String                      @id @default(cuid())
  deviceId       String
  device         NationalLifeConnectorDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  runId          String
  run            NationalLifeSyncRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  gridKey        String
  sequence       Int
  /// Offset da página no portal. Mantido junto do recibo para que a extensão
  /// possa continuar uma fase interrompida sem voltar ao início da grade.
  sourceOffset   Int                         @default(0)
  /// Primeiro offset que ainda não foi enviado depois deste lote/página.
  nextOffset     Int                         @default(0)
  truncated      Boolean                     @default(true)
  contentHash    String
  /// Linhas recebidas na página. Não entra no hash de conteúdo — este é o sha256
  /// do corpo cru. O que fixa seu significado é ser campo público do recibo e,
  /// junto de `writtenCount`, tornar visível "recebi 200, escrevi 0".
  recordCount    Int
  /// Linhas efetivamente escritas depois da normalização. Nulo em recibos
  /// anteriores a esta coluna. Distingue "recebi 200, escrevi 0" — uma página que
  /// o mapeador descartou inteira — de uma página vazia de verdade.
  writtenCount   Int?
  /// Linhas repetidas dentro do lote, removidas pela chave estável antes do
  /// upsert. Repetições entre lotes continuam protegidas pela chave única do
  /// modelo normalizado e pelo idempotency key do recibo.
  duplicateCount Int                         @default(0)
  /// Linhas sem uma chave mínima para a entidade normalizada. A cópia raw da
  /// página continua preservada para auditoria e remapeamento futuro.
  rejectedCount  Int                         @default(0)
  idempotencyKey String                      @unique
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@unique([deviceId, runId, gridKey, sequence])
  @@index([runId, gridKey])
  @@index([runId, truncated])
}

/// A completion is deliberately separate from a page receipt. A receipt proves
/// that one batch landed; it cannot prove that the carrier's final page landed.
/// The connector writes this only after it has uploaded every sequence and the
/// server has reconciled the raw count against the carrier's recordsTotal.
model NationalLifeConnectorStageCompletion {
  id                  String                      @id @default(cuid())
  deviceId            String
  device              NationalLifeConnectorDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  runId               String
  run                 NationalLifeSyncRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  gridKey             String
  expectedRecordCount Int
  receivedRecordCount Int
  finalSequence       Int
  truncated           Boolean                     @default(false)
  completedAt         DateTime                    @default(now())

  @@unique([deviceId, runId, gridKey])
  @@index([runId, gridKey])
}

/// A source failure is a durable, isolated outcome, not a failure of the whole
/// run. `resolvedAt` preserves the attempt while letting a retry make the source
/// pending again without rereading stages that already have completion receipts.
model NationalLifeConnectorStageFailure {
  id            String                      @id @default(cuid())
  deviceId      String
  device        NationalLifeConnectorDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  runId         String
  run           NationalLifeSyncRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  gridKey       String
  safeErrorCode String
  retryable     Boolean                     @default(true)
  failedAt      DateTime                    @default(now())
  resolvedAt    DateTime?
  updatedAt     DateTime                    @updatedAt

  @@unique([deviceId, runId, gridKey])
  @@index([runId, resolvedAt])
}

/// Private, resumable landing zone for official carrier exports. The web UI
/// only receives normalized rows and provenance after validation succeeds.
model NationalLifeExportUpload {
  id             String                      @id @default(cuid())
  agentId        String
  agent          Agent                       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deviceId       String
  device         NationalLifeConnectorDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  runId          String
  run            NationalLifeSyncRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceKey      String
  fileName       String
  contentType    String
  expectedBytes  Int
  expectedSha256 String
  totalChunks    Int
  state          String                      @default("UPLOADING")
  receivedBytes  Int                         @default(0)
  receivedChunks Int                         @default(0)
  rowCount       Int?
  writtenCount   Int?
  safeErrorCode  String?
  fileBytes      Bytes?
  completedAt    DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  chunks         NationalLifeExportChunk[]

  @@unique([deviceId, runId, sourceKey])
  @@index([agentId, createdAt])
  @@index([state, updatedAt])
}

model NationalLifeExportChunk {
  id          String                   @id @default(cuid())
  uploadId    String
  upload      NationalLifeExportUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  sequence    Int
  byteOffset  Int
  byteLength  Int
  contentHash String
  bytes       Bytes
  createdAt   DateTime                 @default(now())

  @@unique([uploadId, sequence])
  @@index([uploadId, byteOffset])
}

/// Resumable, device-scoped transfer of one official correspondence PDF.
/// The carrier handle remains in the already-protected source row; this table
/// stores only the bounded transfer and its integrity proof.
model NationalLifeDocumentTransfer {
  id             String                      @id @default(cuid())
  agentId        String
  agent          Agent                       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deviceId       String
  device         NationalLifeConnectorDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  reportRowId    String
  reportRow      NationalLifeReportRow       @relation(fields: [reportRowId], references: [id], onDelete: Cascade)
  policyId       String
  policy         Policy                      @relation(fields: [policyId], references: [id], onDelete: Cascade)
  documentId     String?                     @unique
  document       PolicyDocument?             @relation(fields: [documentId], references: [id], onDelete: SetNull)
  fileName       String
  contentType    String?
  expectedBytes  Int?
  expectedSha256 String?
  totalChunks    Int?
  state          String                      @default("REQUESTED")
  receivedBytes  Int                         @default(0)
  receivedChunks Int                         @default(0)
  safeErrorCode  String?
  completedAt    DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  chunks         NationalLifeDocumentChunk[]

  @@unique([agentId, reportRowId])
  @@index([deviceId, state])
  @@index([state, updatedAt])
}

model NationalLifeDocumentChunk {
  id          String                       @id @default(cuid())
  transferId  String
  transfer    NationalLifeDocumentTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  sequence    Int
  byteOffset  Int
  byteLength  Int
  contentHash String
  bytes       Bytes
  createdAt   DateTime                     @default(now())

  @@unique([transferId, sequence])
  @@index([transferId, byteOffset])
}

model Illustration {
  id                  String                 @id @default(cuid())
  // A quote is pre-sale: the insured is a prospect who has no case and often no
  // client record either. Requiring a case made the table impossible to write
  // to — it stayed empty from the day it was created.
  caseId              String?
  insuranceCase       InsuranceCase?         @relation(fields: [caseId], references: [id])
  clientId            String?
  client              Client?                @relation(fields: [clientId], references: [id])
  // Always known, and the only thing that scopes a quote to who may read it.
  agentId             String
  agent               Agent                  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  kind                IllustrationKind
  provider            String?
  externalId          String?
  sourceUpdatedAt     DateTime?
  productName         String?
  faceAmount          Decimal?
  premium             Decimal?
  /// The target-premium input or carrier result for this illustration. This is
  /// an estimate until a separate carrier production event confirms the credit.
  targetPremium       Decimal?
  targetPremiumSource String?
  // Held on the illustration rather than only through a relation, so a quote
  // for someone who is not in the system yet still says who it was for.
  insuredName         String?
  insuredDateOfBirth  DateTime?
  documentUrl         String?
  // The illustration PDF as the carrier rendered it. Held as bytes rather than
  // on disk because the carrier runtime is a separate container from the web
  // app, so a file written there is not readable here; at ~1.5 MB a document
  // and this volume that is a fair trade, and moving to object storage later
  // does not change how a caller asks for it.
  documentBytes       Bytes?
  documentMimeType    String?
  documentFetchedAt   DateTime?
  rawPayload          Json?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  scenarios           IllustrationScenario[]

  @@unique([provider, externalId])
  @@index([caseId])
  @@index([agentId, createdAt])
  @@index([clientId])
}

model IllustrationScenario {
  id             String       @id @default(cuid())
  illustrationId String
  illustration   Illustration @relation(fields: [illustrationId], references: [id])
  name           String
  assumptions    Json?
  summary        Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([illustrationId])
}

