FROM node:22-alpine

WORKDIR /app

RUN addgroup -g 10001 broker && adduser -D -u 10001 -G broker broker

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN corepack enable && corepack prepare pnpm@11.15.1 --activate
RUN pnpm install --frozen-lockfile

COPY prisma/schema.prisma ./prisma/schema.prisma
RUN pnpm exec prisma generate

COPY tsconfig.json ./
COPY lib/ ./lib/
COPY workers/kbot-credential-broker/ ./workers/kbot-credential-broker/
COPY scripts/kbot-credential-broker.ts ./scripts/kbot-credential-broker.ts

ENV NODE_ENV=production
ENV NODE_OPTIONS=--conditions=react-server
USER 10001:10001
EXPOSE 3020
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3020/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["./node_modules/.bin/tsx", "scripts/kbot-credential-broker.ts"]
